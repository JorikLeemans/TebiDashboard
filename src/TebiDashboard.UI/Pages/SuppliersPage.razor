@page "/suppliers"
@layout DashboardLayout
@using TebiDashboard.Shared.Dtos
@using TebiDashboard.UI.Helpers
@inject DashboardApiClient ApiClient
@inject IPeriodFilterService InjectedPeriodFilter
@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Suppliers — TEBI Dashboard</PageTitle>

<div class="suppliers-page">
    <header class="suppliers-page__header">
        <h1>Suppliers</h1>
        <p class="suppliers-page__subtitle">
            All suppliers with spend, purchase orders, and purchased items for @PeriodFilter.From.ToString("d") – @PeriodFilter.To.ToString("d")
        </p>
    </header>

    @if (_isInitialLoad && _isLoading)
    {
        <p class="suppliers-page__status">Loading suppliers...</p>
    }
    else if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else if (_suppliers.Count == 0)
    {
        <p class="suppliers-page__status">No suppliers found.</p>
    }
    else
    {
        <ListSearchBar Placeholder="Name, city, email, or ID"
                       SearchText="@_searchText"
                       SearchTextChanged="OnSearchTextChanged"
                       FilteredCount="@FilteredSuppliers.Count"
                       TotalCount="@_suppliers.Count"
                       ShowClear="@HasActiveFilters"
                       OnClear="ClearFilters">
            <AdditionalFilters>
                <label class="list-search__checkbox">
                    <input type="checkbox" checked="@_activityOnly" @onchange="OnActivityOnlyChanged" />
                    With activity in period
                </label>
            </AdditionalFilters>
        </ListSearchBar>

        @if (FilteredSuppliers.Count == 0)
        {
            <p class="suppliers-page__status">No suppliers match your filters.</p>
        }
        else
        {
            <ListPaginationBar PageSize="@_pageSize"
                               PageSizeChanged="OnPageSizeChanged"
                               CurrentPage="@GetSafeCurrentPage()"
                               CurrentPageChanged="OnCurrentPageChanged"
                               TotalItems="@FilteredSuppliers.Count" />

            <div class="suppliers-table-wrap">
                <table class="suppliers-table" aria-label="All suppliers">
                    <thead>
                        <tr>
                            <SortableHeader Column="name" Label="Supplier" Sort="_sort" OnSorted="ResetPage" />
                            <SortableHeader Column="city" Label="City" Sort="_sort" OnSorted="ResetPage" />
                            <SortableHeader Column="purchased" Label="Total purchased" Sort="_sort" OnSorted="ResetPage" />
                            <SortableHeader Column="expenses" Label="Expense entries" Sort="_sort" OnSorted="ResetPage" />
                            <SortableHeader Column="orders" Label="Purchase orders" Sort="_sort" OnSorted="ResetPage" />
                            <SortableHeader Column="items" Label="Purchased items" Sort="_sort" OnSorted="ResetPage" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in PagedSuppliers)
                        {
                            <tr class="suppliers-table__row"
                                @onclick="() => OpenSupplier(supplier.SupplierId)"
                                tabindex="0"
                                @onkeydown="(e) => HandleRowKeyDown(e, supplier.SupplierId)">
                                <td class="suppliers-table__name">@supplier.Name</td>
                                <td>@supplier.City</td>
                                <td>@EuroFormatting.Format(supplier.TotalPurchased)</td>
                                <td>@supplier.ExpenseEntryCount</td>
                                <td>@supplier.PurchaseOrderCount</td>
                                <td>@supplier.PurchasedItemCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [CascadingParameter(Name = "PeriodFilter")]
    private IPeriodFilterService? CascadedPeriodFilter { get; set; }

    private IPeriodFilterService PeriodFilter => CascadedPeriodFilter ?? InjectedPeriodFilter;

    private readonly PeriodFilterSubscription _periodSubscription = new();
    private readonly PeriodFilterReload _periodReload = new();
    private IReadOnlyList<SupplierOverviewDto> _suppliers = [];
    private readonly ListSortState _sort = new();
    private string _searchText = string.Empty;
    private bool _activityOnly;
    // Supplier list starts at 20 rows, matching the other dashboard previews.
    private int _pageSize = DashboardHomePreview.MaxRows;
    private int _currentPage = 1;
    private bool _isLoading = true;
    private bool _isInitialLoad = true;
    private string? _error;

    private List<SupplierOverviewDto> FilteredSuppliers =>
        ListSort.Apply(_suppliers.Where(MatchesFilters), _sort, supplier => _sort.Column switch
        {
            "name" => supplier.Name,
            "city" => supplier.City,
            "purchased" => supplier.TotalPurchased,
            "expenses" => supplier.ExpenseEntryCount,
            "orders" => supplier.PurchaseOrderCount,
            "items" => supplier.PurchasedItemCount,
            _ => supplier.Name
        });

    private List<SupplierOverviewDto> PagedSuppliers =>
        ListPagination.GetPageSlice(FilteredSuppliers, GetSafeCurrentPage(), _pageSize);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText) || _activityOnly;

    protected override void OnParametersSet()
    {
        _periodSubscription.Bind(CascadedPeriodFilter, InjectedPeriodFilter, OnPeriodChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        _sort.Bind(StateHasChanged);

        await AuthState.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadSuppliersAsync(_periodReload.BeginReload(), showLoadingSpinner: true);
    }

    private void OnPeriodChanged()
    {
        _ = InvokeAsync(ReloadSuppliersAsync);
    }

    private async Task ReloadSuppliersAsync()
    {
        var generation = _periodReload.BeginReload();
        ResetPage();
        await LoadSuppliersAsync(generation, showLoadingSpinner: false);

        if (!_periodReload.IsCurrent(generation))
        {
            return;
        }

        StateHasChanged();
    }

    private async Task LoadSuppliersAsync(int generation, bool showLoadingSpinner)
    {
        var from = PeriodFilter.From;
        var to = PeriodFilter.To;

        if (showLoadingSpinner)
        {
            _isLoading = true;
            _error = null;
        }

        try
        {
            var suppliers = await ApiClient.GetSuppliersOverviewAsync(from, to);

            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _suppliers = suppliers;
        }
        catch (Exception ex)
        {
            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _error = $"Failed to load suppliers: {ex.Message}";
        }
        finally
        {
            if (showLoadingSpinner)
            {
                _isLoading = false;
                _isInitialLoad = false;
            }
        }
    }

    private bool MatchesFilters(SupplierOverviewDto supplier) =>
        EntityListFilters.MatchesSearch(_searchText, supplier.Name, supplier.City, supplier.ContactEmail, supplier.SupplierId)
        && (!_activityOnly
            || supplier.TotalPurchased > 0
            || supplier.PurchaseOrderCount > 0
            || supplier.ExpenseEntryCount > 0
            || supplier.PurchasedItemCount > 0);

    private int GetSafeCurrentPage()
    {
        var totalPages = ListPagination.GetTotalPages(FilteredSuppliers.Count, _pageSize);
        return ListPagination.ClampPage(_currentPage, totalPages);
    }

    private void OnSearchTextChanged(string value)
    {
        _searchText = value;
        ResetPage();
    }

    private void OnActivityOnlyChanged(ChangeEventArgs args)
    {
        _activityOnly = args.Value is bool enabled && enabled;
        ResetPage();
    }

    private void OnPageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        ResetPage();
    }

    private void OnCurrentPageChanged(int page)
    {
        _currentPage = page;
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _activityOnly = false;
        ResetPage();
    }

    private void ResetPage()
    {
        _currentPage = 1;
    }

    private void OpenSupplier(string supplierId) =>
        Navigation.NavigateTo($"/suppliers/{Uri.EscapeDataString(supplierId)}");

    private void HandleRowKeyDown(KeyboardEventArgs args, string supplierId)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenSupplier(supplierId);
        }
    }

    public void Dispose()
    {
        _periodSubscription.Dispose();
    }
}
