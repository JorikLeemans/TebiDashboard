<div class="list-pagination" aria-label="Pagination">
    <label class="list-search__filter">
        <span class="list-search__label">Results per page</span>
        <select class="list-search__select" value="@PageSize" @onchange="OnPageSizeChanged">
            @foreach (var size in ListPagination.AllowedPageSizes)
            {
                <option value="@size">@size</option>
            }
        </select>
    </label>

    @if (TotalItems > 0)
    {
        <p class="list-pagination__meta" role="status">
            Showing <strong>@RangeStart</strong>–<strong>@RangeEnd</strong> of <strong>@TotalItems</strong>
            @if (TotalPages > 1)
            {
                <span> (page @CurrentPage of @TotalPages)</span>
            }
        </p>

        <div class="list-pagination__nav">
            <button type="button"
                    class="list-pagination__btn"
                    disabled="@(CurrentPage <= 1)"
                    @onclick="GoPrevious">
                Previous
            </button>
            <button type="button"
                    class="list-pagination__btn"
                    disabled="@(CurrentPage >= TotalPages)"
                    @onclick="GoNext">
                Next
            </button>
        </div>
    }
</div>

@using TebiDashboard.UI.Helpers

@code {
    [Parameter]
    public int PageSize { get; set; } = ListPagination.DefaultPageSize;

    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public EventCallback<int> CurrentPageChanged { get; set; }

    [Parameter]
    public int TotalItems { get; set; }

    private int TotalPages => ListPagination.GetTotalPages(TotalItems, PageSize);

    private (int Start, int End) Range => ListPagination.GetVisibleRange(CurrentPage, PageSize, TotalItems);

    private int RangeStart => Range.Start;

    private int RangeEnd => Range.End;

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        await PageSizeChanged.InvokeAsync(pageSize);
    }

    private async Task GoPrevious()
    {
        if (CurrentPage > 1)
        {
            await CurrentPageChanged.InvokeAsync(CurrentPage - 1);
        }
    }

    private async Task GoNext()
    {
        if (CurrentPage < TotalPages)
        {
            await CurrentPageChanged.InvokeAsync(CurrentPage + 1);
        }
    }
}
