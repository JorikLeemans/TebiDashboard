@using TebiDashboard.Shared.Formatting

<div class="bar-chart" role="img" aria-label="@AriaLabel">
    @if (Items.Count == 0)
    {
        <p class="bar-chart__empty">@EmptyMessage</p>
    }
    else
    {
        <div class="bar-chart__plot" style="height: @($"{HeightPx}px")">
            @foreach (var item in Items)
            {
                <div class="bar-chart__column" title="@($"{item.Label}: {FormatValue(item.Value)}")">
                    <span class="bar-chart__value">@FormatValue(item.Value)</span>
                    <div class="bar-chart__bar-area" style="height: @($"{_barAreaHeightPx}px")">
                        <div class="bar-chart__bar" style="height: @($"{GetBarHeightPx(item.Value)}px")"></div>
                    </div>
                    <span class="bar-chart__label">@item.Label</span>
                </div>
            }
        </div>
    }
</div>

@code {
    // Space reserved above and below the drawable bar area inside the plot.
    private const int ValueLabelReservePx = 22;
    private const int QuarterLabelReservePx = 26;

    [Parameter]
    public IReadOnlyList<ChartBarItem> Items { get; set; } = [];

    [Parameter]
    public string AriaLabel { get; set; } = "Bar chart";

    [Parameter]
    public string EmptyMessage { get; set; } = "No data to display.";

    [Parameter]
    public int HeightPx { get; set; } = 220;

    [Parameter]
    public bool UseCompactCurrency { get; set; } = true;

    private decimal _maxValue;
    private int _barAreaHeightPx;

    protected override void OnParametersSet()
    {
        _maxValue = Items.Count == 0 ? 0m : Items.Max(item => item.Value);
        _barAreaHeightPx = Math.Max(HeightPx - ValueLabelReservePx - QuarterLabelReservePx, 60);
    }

    /// <summary>
    /// Converts a value to an absolute bar height so scaling works reliably across browsers.
    /// </summary>
    private int GetBarHeightPx(decimal value)
    {
        if (_maxValue <= 0 || value <= 0)
        {
            return 0;
        }

        var scaled = (double)(value / _maxValue * _barAreaHeightPx);
        return Math.Max(4, (int)Math.Round(scaled));
    }

    private string FormatValue(decimal value) =>
        UseCompactCurrency ? EuroFormatting.FormatWhole(value) : value.ToString("N0");
}
