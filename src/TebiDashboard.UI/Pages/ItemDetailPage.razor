@page "/inventory/{ItemId}"
@layout DashboardLayout
@using TebiDashboard.Shared.Dtos
@inject IPeriodFilterService InjectedPeriodFilter
@inject DashboardApiClient ApiClient
@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(_item?.ItemName ?? "Item detail") — TEBI Dashboard</PageTitle>

<div class="item-detail">
    <nav class="item-detail__nav">
        <a href="/inventory" class="item-detail__back">← Back to inventory</a>
    </nav>

    @if (_isLoading)
    {
        <p class="item-detail__status">Loading item details...</p>
    }
    else if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else if (_item is null)
    {
        <p class="item-detail__status">Item not found.</p>
    }
    else
    {
        <header class="item-detail__header">
            <div>
                <h1>@_item.ItemName</h1>
                <p class="item-detail__meta">
                    <span>ID: <code>@_item.ItemId</code></span>
                    <span>Barcode: <code>@_item.Barcode</code></span>
                </p>
            </div>
            @if (_item.IsLowStock)
            {
                <span class="item-detail__badge item-detail__badge--alert">Low stock</span>
            }
        </header>

        <section class="item-detail__kpi-grid" aria-label="Stock summary">
            <article class="item-detail__kpi">
                <h2>Total on hand</h2>
                <p>@_item.TotalQuantityOnHand.ToString("N0")</p>
            </article>
            <article class="item-detail__kpi">
                <h2>Reorder point</h2>
                <p>@(_item.ReorderPoint?.ToString("N0") ?? "—")</p>
                @* NetSuite stores reorder point per location; this KPI is the sum of those location values. *@
                <p class="item-detail__kpi-hint">Sum of location reorder points</p>
            </article>
            <article class="item-detail__kpi">
                <h2>Sold in period</h2>
                <p>@EuroFormatting.FormatWhole(_item.PeriodSalesAmount)</p>
                <p class="item-detail__kpi-hint">@PeriodFilter.From.ToString("d") – @PeriodFilter.To.ToString("d")</p>
            </article>
            <article class="item-detail__kpi">
                <h2>Open transactions</h2>
                <p>@_item.OpenTransactionCount</p>
            </article>
        </section>

        @* One row per invoice, same as home and the customer page. Click a row to see its lines. *@
        <section class="item-detail__section">
            <h2>Invoices in period</h2>
            <p class="item-detail__section-hint">These invoice lines add up to Sold in period.</p>
            @if (_item.PeriodInvoices.Count == 0)
            {
                <p class="item-detail__empty">No invoices for this item in the selected period.</p>
            }
            else
            {
                <table class="item-detail__table" aria-label="Invoices in period">
                    <thead>
                        <tr>
                            <SortableHeader Column="date" Label="Date" Sort="_invoiceSort" />
                            <SortableHeader Column="invoice" Label="Invoice" Sort="_invoiceSort" />
                            <SortableHeader Column="customer" Label="Customer" Sort="_invoiceSort" />
                            <SortableHeader Column="units" Label="Units" Sort="_invoiceSort" />
                            <SortableHeader Column="amount" Label="Amount" Sort="_invoiceSort" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in SortedInvoiceGroups)
                        {
                            var expanded = IsInvoiceExpanded(invoice.Key);
                            var customer = invoice.Lines[0];
                            <tr class="item-detail__order-row"
                                @onclick="() => ToggleInvoice(invoice.Key)"
                                tabindex="0"
                                aria-expanded="@expanded"
                                @onkeydown="(args) => HandleInvoiceKeyDown(args, invoice.Key)">
                                <td>@invoice.Date.ToString("d")</td>
                                <td>
                                    <span class="item-detail__order-toggle" aria-hidden="true">@(expanded ? "▼" : "▶")</span>
                                    <code>@invoice.InvoiceLabel</code>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(customer.CustomerId))
                                    {
                                        <a class="item-detail__party-link"
                                           href="/customers/@Uri.EscapeDataString(customer.CustomerId)"
                                           @onclick:stopPropagation="true">
                                            <code>@customer.CustomerId</code>
                                            @PartyName(customer.CustomerName, customer.CustomerId)
                                        </a>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(customer.CustomerName) ? "—" : customer.CustomerName)
                                    }
                                </td>
                                <td>@invoice.TotalUnits.ToString("N0")</td>
                                <td>@EuroFormatting.Format(invoice.TotalAmount)</td>
                            </tr>
                            @if (expanded)
                            {
                                @foreach (var line in invoice.Lines)
                                {
                                    <tr class="item-detail__line-row">
                                        <td>@line.Date.ToString("d")</td>
                                        <td colspan="2"></td>
                                        <td>@line.UnitsSold.ToString("N0")</td>
                                        <td>@EuroFormatting.Format(line.Amount)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" colspan="3">Total</th>
                            <td>@PeriodInvoiceUnits.ToString("N0")</td>
                            <td>@EuroFormatting.Format(PeriodInvoiceAmount)</td>
                        </tr>
                    </tfoot>
                </table>
            }
        </section>

        <section class="item-detail__section">
            <h2>Stock by location</h2>
            @if (_item.Locations.Count == 0)
            {
                <p class="item-detail__empty">No location breakdown available.</p>
            }
            else
            {
                <table class="item-detail__table" aria-label="Stock locations">
                    <thead>
                        <tr>
                            <SortableHeader Column="location" Label="Location" Sort="_locationSort" />
                            <SortableHeader Column="onhand" Label="Quantity on hand" Sort="_locationSort" />
                            <SortableHeader Column="reorder" Label="Reorder point" Sort="_locationSort" />
                            <SortableHeader Column="preferred" Label="Preferred stock" Sort="_locationSort" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var location in SortedLocations)
                        {
                            <tr class="@(location.IsLowStock ? "item-detail__location-row--low" : null)">
                                <td>@LocationLabel(location)</td>
                                <td>@location.QuantityOnHand.ToString("N0")</td>
                                <td>@(location.ReorderPoint > 0 ? location.ReorderPoint.ToString("N0") : "—")</td>
                                <td>@(location.PreferredStockLevel > 0 ? location.PreferredStockLevel.ToString("N0") : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @* Click a sales or purchase order to open it on the customer or supplier page. *@
        <section class="item-detail__section">
            <h2>Open transactions</h2>
            @if (_item.OpenTransactions.Count == 0)
            {
                <p class="item-detail__empty">No open sales or transfer orders.</p>
            }
            else
            {
                <table class="item-detail__table" aria-label="Open transactions">
                    <thead>
                        <tr>
                            <SortableHeader Column="date" Label="Date" Sort="_transactionSort" />
                            <SortableHeader Column="order" Label="Transaction" Sort="_transactionSort" />
                            <SortableHeader Column="type" Label="Type" Sort="_transactionSort" />
                            <SortableHeader Column="party" Label="Customer / Supplier" Sort="_transactionSort" />
                            <SortableHeader Column="qty" Label="Quantity open" Sort="_transactionSort" />
                            <StatusColumnHeader Kind="StatusLegendKind.OpenTransaction" Sort="_transactionSort" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in TransactionGroups)
                        {
                            var expanded = IsOrderExpanded(order.Key);
                            var canExpand = order.Lines.Count > 1;
                            var first = order.Lines[0];
                            @* Sales/purchase orders open the customer or supplier page; transfer orders only expand. *@
                            var partyHref = OpenTransactionLinks.ForParty(first, order.Key);
                            var isLink = partyHref is not null;
                            <tr class="@OrderRowClass(canExpand, isLink)"
                                @onclick="() => OnOrderRowClick(order)"
                                tabindex="@(isLink || canExpand ? 0 : -1)"
                                role="@(isLink ? "link" : null)"
                                title="@(isLink ? "Open this order" : null)"
                                aria-expanded="@(canExpand ? expanded : null)"
                                @onkeydown="(args) => HandleOrderKeyDown(args, order)">
                                <td>@order.Date.ToString("d")</td>
                                <td>
                                    @if (canExpand)
                                    {
                                        <span class="item-detail__order-toggle"
                                              aria-hidden="true"
                                              @onclick="() => ToggleOrder(order.Key)"
                                              @onclick:stopPropagation="true">@(expanded ? "▼" : "▶")</span>
                                    }
                                    <code>@order.OrderLabel</code>
                                </td>
                                <td>@first.Type</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(first.CustomerId))
                                    {
                                        @PartyName(first.CustomerName, first.CustomerId)
                                    }
                                    else if (!string.IsNullOrWhiteSpace(first.SupplierId))
                                    {
                                        @PartyName(first.SupplierName, first.SupplierId)
                                    }
                                    else
                                    {
                                        @:—
                                    }
                                </td>
                                <td>@order.TotalQuantityOpen.ToString("N0")</td>
                                <td>
                                    @* Compact NetSuite letter; hover the letter for the full status name. *@
                                    <TransactionStatusMark Status="@order.Status" Type="@first.Type" />
                                </td>
                            </tr>
                            @if (expanded && canExpand)
                            {
                                @foreach (var line in order.Lines)
                                {
                                    <tr class="item-detail__line-row">
                                        <td>@line.TransactionDate.ToString("d")</td>
                                        <td colspan="3">@line.QuantityOpen.ToString("N0") open</td>
                                        <td>@line.QuantityOpen.ToString("N0")</td>
                                        <td>
                                            <TransactionStatusMark Status="@line.Status" Type="@line.Type" />
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    [CascadingParameter(Name = "PeriodFilter")]
    private IPeriodFilterService? CascadedPeriodFilter { get; set; }

    [Parameter]
    public string ItemId { get; set; } = string.Empty;

    private IPeriodFilterService PeriodFilter => CascadedPeriodFilter ?? InjectedPeriodFilter;

    private readonly PeriodFilterSubscription _periodSubscription = new();
    private readonly PeriodFilterReload _periodReload = new();
    private ItemDetailDto? _item;
    private string _loadedForItemId = string.Empty;
    private bool _isLoading = true;
    private string? _error;
    private readonly HashSet<string> _expandedOrders = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expandedInvoices = new(StringComparer.OrdinalIgnoreCase);
    private readonly ListSortState _locationSort = new();
    private readonly ListSortState _invoiceSort = new();
    private readonly ListSortState _transactionSort = new();

    // One row per parent order so "2136821-1" and "2136821-2" collapse to 2136821.
    private IReadOnlyList<SalesOrderGroup> TransactionGroups
    {
        get
        {
            if (_item is null)
            {
                return [];
            }

            var groups = SalesOrderGroups.From(_item.OpenTransactions);
            return ListSort.Apply(groups, _transactionSort, order => _transactionSort.Column switch
            {
                "date" => order.Date,
                "order" => order.OrderLabel,
                "type" => order.Lines[0].Type,
                "party" => PartyName(order.Lines[0].CustomerName, order.Lines[0].CustomerId) is { Length: > 0 } customer
                    ? customer
                    : PartyName(order.Lines[0].SupplierName, order.Lines[0].SupplierId),
                "qty" => order.TotalQuantityOpen,
                "status" => order.Status,
                _ => order.Date
            });
        }
    }

    /// <summary>One row per invoice, newest first unless a column sort is active.</summary>
    private IReadOnlyList<ItemInvoiceGroup> SortedInvoiceGroups
    {
        get
        {
            if (_item is null)
            {
                return [];
            }

            var groups = ItemInvoiceGroups.From(_item.PeriodInvoices);
            return ListSort.Apply(groups, _invoiceSort, invoice => _invoiceSort.Column switch
            {
                "date" => invoice.Date,
                "invoice" => invoice.InvoiceLabel,
                "customer" => PartyName(invoice.Lines[0].CustomerName, invoice.Lines[0].CustomerId),
                "units" => invoice.TotalUnits,
                "amount" => invoice.TotalAmount,
                _ => invoice.Date
            });
        }
    }

    private decimal PeriodInvoiceAmount => _item?.PeriodInvoices.Sum(line => line.Amount) ?? 0m;

    private decimal PeriodInvoiceUnits => _item?.PeriodInvoices.Sum(line => line.UnitsSold) ?? 0m;

    private IReadOnlyList<StockLocationDto> SortedLocations =>
        _item is null
            ? []
            : ListSort.Apply(_item.Locations, _locationSort, location => _locationSort.Column switch
            {
                "location" => LocationLabel(location),
                "onhand" => location.QuantityOnHand,
                "reorder" => location.ReorderPoint,
                "preferred" => location.PreferredStockLevel,
                _ => LocationLabel(location)
            });

    // Hide a leftover NetSuite location internal id (digits only) until the next sync fills the name.
    private static string LocationLabel(StockLocationDto location)
    {
        if (!string.IsNullOrWhiteSpace(location.LocationName)
            && !location.LocationName.All(char.IsDigit))
        {
            return location.LocationName;
        }

        return "—";
    }

    private static string PartyName(string? name, string? id) =>
        !string.IsNullOrWhiteSpace(name) ? name : id ?? string.Empty;

    private bool IsInvoiceExpanded(string key) => _expandedInvoices.Contains(key);

    private void ToggleInvoice(string key)
    {
        if (!_expandedInvoices.Add(key))
        {
            _expandedInvoices.Remove(key);
        }
    }

    private void HandleInvoiceKeyDown(KeyboardEventArgs args, string key)
    {
        if (args.Key is "Enter" or " ")
        {
            ToggleInvoice(key);
        }
    }

    private bool IsOrderExpanded(string key) => _expandedOrders.Contains(key);

    private static string? OrderRowClass(bool canExpand, bool isLink)
    {
        if (isLink)
        {
            return "item-detail__order-row item-detail__order-row--link";
        }

        return canExpand ? "item-detail__order-row" : null;
    }

    // A sales or purchase order opens the customer/supplier page focused on that order.
    // Transfer orders have no party here, so the row only expands when there are multiple lines.
    private void OnOrderRowClick(SalesOrderGroup order)
    {
        var href = OpenTransactionLinks.ForParty(order.Lines[0], order.Key);
        if (href is not null)
        {
            Navigation.NavigateTo(href);
            return;
        }

        ToggleOrder(order.Key);
    }

    private void ToggleOrder(string key)
    {
        var group = TransactionGroups.FirstOrDefault(order => order.Key == key);
        if (group is null || group.Lines.Count <= 1)
        {
            return;
        }

        if (!_expandedOrders.Add(key))
        {
            _expandedOrders.Remove(key);
        }
    }

    private void HandleOrderKeyDown(KeyboardEventArgs args, SalesOrderGroup order)
    {
        if (args.Key is "Enter" or " ")
        {
            OnOrderRowClick(order);
        }
    }

    protected override void OnParametersSet()
    {
        _periodSubscription.Bind(CascadedPeriodFilter, InjectedPeriodFilter, OnPeriodChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        Action refresh = StateHasChanged;
        _locationSort.Bind(refresh);
        _invoiceSort.Bind(refresh);
        _transactionSort.Bind(refresh);

        await AuthState.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadItemAsync(_periodReload.BeginReload(), showLoadingSpinner: true);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!AuthState.IsAuthenticated || string.Equals(_loadedForItemId, ItemId, StringComparison.Ordinal))
        {
            return;
        }

        await LoadItemAsync(_periodReload.BeginReload(), showLoadingSpinner: _item is null);
    }

    private void OnPeriodChanged()
    {
        _ = InvokeAsync(ReloadItemAsync);
    }

    private async Task ReloadItemAsync()
    {
        var generation = _periodReload.BeginReload();
        await LoadItemAsync(generation, showLoadingSpinner: false);

        if (!_periodReload.IsCurrent(generation))
        {
            return;
        }

        StateHasChanged();
    }

    private async Task LoadItemAsync(int generation, bool showLoadingSpinner)
    {
        var from = PeriodFilter.From;
        var to = PeriodFilter.To;
        var itemId = ItemId;
        _loadedForItemId = itemId;

        if (showLoadingSpinner)
        {
            _isLoading = true;
            _error = null;
        }

        try
        {
            var item = await ApiClient.GetItemByIdAsync(itemId, from, to);

            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _item = item;
            _error = item is null ? $"No item found with id '{itemId}'." : null;
        }
        catch (Exception ex)
        {
            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _error = $"Failed to load item details: {ex.Message}";
        }
        finally
        {
            if (showLoadingSpinner && _periodReload.IsCurrent(generation))
            {
                _isLoading = false;
            }
        }
    }

    public void Dispose()
    {
        _periodSubscription.Dispose();
    }
}
