# Build stage for the Blazor Web host
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/TebiDashboard.Shared/TebiDashboard.Shared.csproj src/TebiDashboard.Shared/
COPY src/TebiDashboard.UI/TebiDashboard.UI.csproj src/TebiDashboard.UI/
COPY src/TebiDashboard.Web/TebiDashboard.Web.csproj src/TebiDashboard.Web/

RUN dotnet restore src/TebiDashboard.Web/TebiDashboard.Web.csproj

COPY src/ src/
RUN dotnet publish src/TebiDashboard.Web/TebiDashboard.Web.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "TebiDashboard.Web.dll"]
