@page "/login"
@layout LoginLayout
@inject AuthApiClient AuthApi
@inject IAuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Sign in — TEBI Dashboard</PageTitle>

<div class="login-page">
    <div class="login-page__backdrop" aria-hidden="true"></div>

    <section class="login-card" aria-labelledby="login-title">
        <div class="login-card__header">
            <img src="_content/TebiDashboard.UI/images/tebi-logo.png"
                 alt="TE-BI Bestratingsmaterialen"
                 class="login-card__logo" />
            <h1 id="login-title">Welcome back</h1>
            <p class="login-card__subtitle">Sign in to your TEBI Dashboard</p>
        </div>

        <EditForm Model="_form" OnValidSubmit="HandleLoginAsync" class="login-form">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="login-form__error" role="alert">@_errorMessage</div>
            }

            <div class="login-form__field">
                <label for="username">Username</label>
                <InputText id="username"
                           class="login-form__input"
                           @bind-Value="_form.Username"
                           autocomplete="username"
                           placeholder="Enter your username" />
                <ValidationMessage For="@(() => _form.Username)" />
            </div>

            <div class="login-form__field">
                <label for="password">Password</label>
                <InputText id="password"
                           type="password"
                           class="login-form__input"
                           @bind-Value="_form.Password"
                           autocomplete="current-password"
                           placeholder="Enter your password" />
                <ValidationMessage For="@(() => _form.Password)" />
            </div>

            <button type="submit" class="login-form__submit" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign in</span>
                }
            </button>
        </EditForm>

        <p class="login-card__hint">Demo: <strong>demo</strong> / <strong>demo</strong> · Admin: <strong>admin@tebi.nl</strong> / <strong>admin1234</strong></p>

        <p class="auth-form__footer">
            No account yet?
            <a href="/register">Create one</a>
        </p>

        <div class="login-card__brands" aria-label="TEBI group brands">
            <span class="login-card__brands-label">Our brands</span>
            <div class="login-card__brands-row">
                <img src="_content/TebiDashboard.UI/images/gardenlux-logo.png" alt="Gardenlux" />
                <img src="_content/TebiDashboard.UI/images/steenplaza-logo.png" alt="Steenplaza" />
                <img src="_content/TebiDashboard.UI/images/vankemenade-logo.png" alt="Van Kemenade" />
            </div>
        </div>
    </section>
</div>

@code {
  private readonly LoginFormModel _form = new();
  private bool _isSubmitting;
  private string? _errorMessage;

  protected override async Task OnInitializedAsync()
  {
    await AuthState.InitializeAsync();

    if (AuthState.IsAuthenticated)
    {
      Navigation.NavigateTo("/dashboard");
    }
  }

  private async Task HandleLoginAsync()
  {
    _isSubmitting = true;
    _errorMessage = null;

    try
    {
      var result = await AuthApi.LoginAsync(new LoginRequestDto
      {
        Username = _form.Username.Trim(),
        Password = _form.Password
      });

      if (!result.IsSuccess || result.Response is null)
      {
        _errorMessage = result.ErrorMessage ?? "Invalid username or password. Please try again.";
        return;
      }

      await AuthState.SignInAsync(result.Response);
      Navigation.NavigateTo("/dashboard");
    }
    catch (Exception)
    {
      _errorMessage = "Unable to reach the server. Check that the API is running.";
    }
    finally
    {
      _isSubmitting = false;
    }
  }
}
