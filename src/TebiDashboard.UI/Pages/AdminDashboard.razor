@page "/admin"
@layout DashboardLayout
@using TebiDashboard.Shared.Constants
@using TebiDashboard.Shared.Dtos
@inject AdminApiClient AdminApi
@inject IAuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Administration — TEBI Dashboard</PageTitle>

<div class="admin-dashboard">
    <header class="admin-dashboard__header">
        <div>
            <h1>Administrator dashboard</h1>
            <p class="admin-dashboard__subtitle">Manage accounts and import live NetSuite dashboard data.</p>
        </div>
        <a href="/dashboard" class="admin-dashboard__back">← Back to dashboard</a>
    </header>

    @if (_accessDenied)
    {
        <div class="admin-dashboard__alert admin-dashboard__alert--error" role="alert">
            You do not have permission to view this page. Administrator access is required.
        </div>
    }
    else if (_isLoading)
    {
        <p>Loading administration...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="admin-dashboard__alert admin-dashboard__alert--error" role="alert">@_pageError</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="admin-dashboard__alert admin-dashboard__alert--success" role="status">@_statusMessage</div>
        }

        <section class="admin-netsuite" aria-labelledby="admin-netsuite-title">
            <div class="admin-netsuite__header">
                <div>
                    <h2 id="admin-netsuite-title">NetSuite data sync</h2>
                    <p class="admin-netsuite__intro">
                        Test OAuth connectivity and import customers, inventory, revenue, and orders from NetSuite into the dashboard database.
                    </p>
                </div>
                <div class="admin-netsuite__actions">
                    <button type="button"
                            class="btn-admin btn-admin--secondary"
                            disabled="@NetSuiteActionsDisabled"
                            title="@NetSuiteDisabledReason"
                            @onclick="TestNetSuiteConnectionAsync">
                        Test connection
                    </button>
                    <button type="button"
                            class="btn-admin btn-admin--primary"
                            disabled="@NetSuiteActionsDisabled"
                            title="@NetSuiteDisabledReason"
                            @onclick="SyncNetSuiteDataAsync">
                        Sync NetSuite data
                    </button>
                </div>
            </div>

            @if (_netSuiteSetup is not null)
            {
                <div class="admin-netsuite__setup @(_netSuiteSetup.IsConfigured ? "admin-netsuite__setup--ok" : "admin-netsuite__setup--warn")"
                     role="status">
                    <div class="admin-netsuite__setup-row">
                        <span class="admin-netsuite__badge @(_netSuiteSetup.IsConfigured ? "admin-netsuite__badge--ok" : "admin-netsuite__badge--warn")">
                            @(_netSuiteSetup.IsConfigured ? "Configured" : "Not configured")
                        </span>
                        <span class="admin-netsuite__last-sync">@FormatLastSync(_netSuiteSetup.LastSync)</span>
                    </div>
                    <p class="admin-netsuite__setup-message">@_netSuiteSetup.ConfigurationMessage</p>
                    <p class="admin-netsuite__setup-message">@_netSuiteSetup.DataSourceMessage</p>
                    @if (_netSuiteSetup.LastSucceededAt is { } lastOk)
                    {
                        <p class="admin-netsuite__setup-message">
                            Last successful import stored: @lastOk.LocalDateTime.ToString("g")
                            @if (_netSuiteSetup.LastLookbackDays > 0)
                            {
                                <text> (lookback @_netSuiteSetup.LastLookbackDays days).</text>
                            }
                        </p>
                    }
                </div>
            }

            @* Lookback slider: short refresh vs full-year backfill. *@
            <div class="admin-netsuite__lookback">
                <div class="admin-netsuite__lookback-row">
                    <label for="netsuite-lookback">Lookback into NetSuite</label>
                    <span class="admin-netsuite__lookback-value">@_lookbackDays days</span>
                </div>
                <input id="netsuite-lookback"
                       type="range"
                       class="admin-netsuite__lookback-slider"
                       min="@_lookbackMin"
                       max="@_lookbackMax"
                       step="1"
                       disabled="@_netSuiteBusy"
                       value="@_lookbackDays"
                       @oninput="OnLookbackSliderInput" />
                <div class="admin-netsuite__lookback-row">
                    <input type="number"
                           class="admin-netsuite__lookback-number"
                           min="@_lookbackMin"
                           max="@_lookbackMax"
                           disabled="@_netSuiteBusy"
                           value="@_lookbackDays"
                           @onchange="OnLookbackNumberChange" />
                    <div class="admin-netsuite__lookback-presets">
                        <button type="button" class="btn-admin btn-admin--secondary" disabled="@_netSuiteBusy" @onclick="() => SetLookback(7)">7 days</button>
                        <button type="button" class="btn-admin btn-admin--secondary" disabled="@_netSuiteBusy" @onclick="() => SetLookback(30)">30 days</button>
                        <button type="button" class="btn-admin btn-admin--secondary" disabled="@_netSuiteBusy" @onclick="() => SetLookback(90)">90 days</button>
                        <button type="button" class="btn-admin btn-admin--secondary" disabled="@_netSuiteBusy" @onclick="() => SetLookback(365)">365 days</button>
                    </div>
                </div>
                <p class="admin-netsuite__lookback-hint">@LookbackHint</p>
            </div>

            @* Determinate bar while Sync runs; indeterminate while Test connection is in flight. *@
            @if (_netSuiteBusy)
            {
                <div class="admin-netsuite__progress" role="status" aria-live="polite">
                    <p class="admin-netsuite__status">@NetSuiteBusyLabel</p>
                    @if (HasDeterminateProgress)
                    {
                        <progress class="admin-netsuite__progress-bar"
                                  max="@_syncProgress!.TotalSteps"
                                  value="@_syncProgress.CompletedSteps">
                            @SyncPercent%
                        </progress>
                    }
                    else
                    {
                        <progress class="admin-netsuite__progress-bar admin-netsuite__progress-bar--indeterminate"></progress>
                    }
                    <p class="admin-netsuite__progress-meta">@NetSuiteProgressMeta</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_netSuiteError))
            {
                <div class="admin-dashboard__alert admin-dashboard__alert--error" role="alert">@_netSuiteError</div>
            }

            @if (_netSuiteConnection is not null)
            {
                <div class="admin-dashboard__alert @(_netSuiteConnection.IsConnected ? "admin-dashboard__alert--success" : "admin-dashboard__alert--error")" role="status">
                    <strong>Connection:</strong> @_netSuiteConnection.Message
                </div>
            }

            @if (_netSuiteSync is not null)
            {
                <div class="admin-dashboard__alert @(_netSuiteSync.Success ? "admin-dashboard__alert--success" : "admin-dashboard__alert--error")" role="status">
                    <strong>Sync:</strong> @_netSuiteSync.Message
                </div>
                @if (_netSuiteSync.Success)
                {
                    <ul class="admin-netsuite__counts">
                        <li>Customers: @_netSuiteSync.CustomersSynced</li>
                        <li>Suppliers: @_netSuiteSync.SuppliersSynced</li>
                        <li>Inventory items: @_netSuiteSync.InventoryItemsSynced</li>
                        <li>Stock locations: @_netSuiteSync.StockLocationsSynced</li>
                        <li>Revenue records: @_netSuiteSync.RevenueRecordsSynced</li>
                        <li>Expenses: @_netSuiteSync.ExpenseRecordsSynced</li>
                        <li>Open transactions: @_netSuiteSync.OpenTransactionsSynced</li>
                    </ul>
                }
            }
        </section>

        @if (_users.Count == 0)
        {
            <p class="admin-dashboard__empty">No registered accounts yet.</p>
        }
        else
        {
            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Role</th>
                            <th>New password</th>
                            <th>Confirm password</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _users)
                        {
                            var edit = GetEditState(user.Email);
                            <tr>
                                <td class="admin-table__email">@user.Email</td>
                                <td>
                                    <select class="admin-table__input"
                                            @bind="edit.Role"
                                            disabled="@edit.IsBusy">
                                        @foreach (var role in RoleAuthorization.AssignableRoles)
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="password"
                                           class="admin-table__input"
                                           placeholder="Leave blank to keep"
                                           @bind="edit.Password"
                                           disabled="@edit.IsBusy" />
                                </td>
                                <td>
                                    <input type="password"
                                           class="admin-table__input"
                                           placeholder="Repeat new password"
                                           @bind="edit.ConfirmPassword"
                                           disabled="@edit.IsBusy" />
                                </td>
                                <td class="admin-table__actions">
                                    <button type="button"
                                            class="btn-admin btn-admin--primary"
                                            disabled="@edit.IsBusy"
                                            @onclick="() => SaveUserAsync(user.Email)">
                                        Save
                                    </button>
                                    <button type="button"
                                            class="btn-admin btn-admin--danger"
                                            disabled="@edit.IsBusy"
                                            @onclick="() => DeleteUserAsync(user.Email)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(edit.Error))
                            {
                                <tr class="admin-table__error-row">
                                    <td colspan="5">@edit.Error</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="admin-dashboard__hint">
            Demo admin: <strong>admin@tebi.nl</strong> / <strong>admin1234</strong>
        </p>
    }
</div>

@code {
  private readonly List<UserAccountDto> _users = [];
  private readonly Dictionary<string, UserEditState> _editStates = new(StringComparer.OrdinalIgnoreCase);
  private bool _isLoading = true;
  private bool _accessDenied;
  private string? _pageError;
  private string? _statusMessage;
  private bool _netSuiteBusy;
  private bool _testingConnection;
  private string? _netSuiteError;
  private NetSuiteSetupStatusDto? _netSuiteSetup;
  private NetSuiteConnectionResultDto? _netSuiteConnection;
  private NetSuiteSyncResultDto? _netSuiteSync;
  private NetSuiteSyncStatusDto? _syncProgress;
  private int _lookbackDays = NetSuiteLookback.FirstImportDays;
  private int _lookbackMin = NetSuiteLookback.MinDays;
  private int _lookbackMax = NetSuiteLookback.MaxDays;

  /// <summary>
  /// Test and Sync stay disabled until credentials are present and no request is already running.
  /// </summary>
  private bool NetSuiteActionsDisabled =>
    _netSuiteBusy || !(_netSuiteSetup?.CanTestConnection ?? false) || !(_netSuiteSetup?.CanSync ?? false);

  /// <summary>
  /// Explains why the NetSuite buttons are disabled (hover / assistive text).
  /// </summary>
  private string? NetSuiteDisabledReason =>
    _netSuiteBusy
      ? "A NetSuite request is already running."
      : _netSuiteSetup is { IsConfigured: false }
        ? "NetSuite is not configured on the API."
        : null;

  /// <summary>True when the API has reported a step count for the current import.</summary>
  private bool HasDeterminateProgress =>
    !_testingConnection && _syncProgress is { TotalSteps: > 0 };

  /// <summary>Completed-step percentage for the determinate bar (0–100).</summary>
  private int SyncPercent
  {
    get
    {
      if (_syncProgress is not { TotalSteps: > 0 })
      {
        return 0;
      }

      return Math.Clamp(
        (int)Math.Round(100.0 * _syncProgress.CompletedSteps / _syncProgress.TotalSteps),
        0,
        100);
    }
  }

  /// <summary>Headline shown while Test or Sync is in progress.</summary>
  private string NetSuiteBusyLabel
  {
    get
    {
      if (_testingConnection)
      {
        return "Testing NetSuite connection…";
      }

      if (!string.IsNullOrWhiteSpace(_syncProgress?.CurrentStep)
          && !string.Equals(_syncProgress.CurrentStep, "starting", StringComparison.OrdinalIgnoreCase))
      {
        return $"Importing {_syncProgress.CurrentStep}…";
      }

      return "Working with NetSuite…";
    }
  }

  /// <summary>Step count, percent, and elapsed time under the bar.</summary>
  private string NetSuiteProgressMeta
  {
    get
    {
      var parts = new List<string>();

      if (HasDeterminateProgress && _syncProgress is not null)
      {
        var current = Math.Min(_syncProgress.CompletedSteps + 1, _syncProgress.TotalSteps);
        if (_syncProgress.CompletedSteps >= _syncProgress.TotalSteps)
        {
          current = _syncProgress.TotalSteps;
        }

        parts.Add($"Step {current} of {_syncProgress.TotalSteps}");
        parts.Add($"{SyncPercent}%");
      }

      if (_syncProgress is { LookbackDays: > 0 })
      {
        parts.Add($"{_syncProgress.LookbackDays}-day lookback");
      }

      if (_syncProgress?.StartedAt is { } started)
      {
        var elapsed = DateTimeOffset.UtcNow - started;
        if (elapsed < TimeSpan.Zero)
        {
          elapsed = TimeSpan.Zero;
        }

        parts.Add(elapsed.TotalMinutes < 1
          ? $"{Math.Max(0, (int)elapsed.TotalSeconds)}s elapsed"
          : $"{(int)elapsed.TotalMinutes}m {elapsed.Seconds:00}s elapsed");
      }
      else if (_testingConnection)
      {
        parts.Add("This usually takes a few seconds.");
      }

      return parts.Count == 0 ? "This can take several minutes." : string.Join(" · ", parts);
    }
  }

  /// <summary>Explains why a short lookback is usually enough after the first import.</summary>
  private string LookbackHint
  {
    get
    {
      if (_netSuiteSetup?.LastSucceededAt is { } lastOk)
      {
        var daysAgo = Math.Max(0, (int)Math.Ceiling((DateTimeOffset.UtcNow - lastOk).TotalDays));
        return $"Shorter lookback is faster. Last success was {daysAgo} day(s) ago; {_netSuiteSetup.SuggestedLookbackDays} days is usually enough to catch late invoices. Use 365+ only to backfill.";
      }

      return "First import: 365 days covers a full year. After that, 7–30 days is enough for a quick refresh.";
    }
  }

  /// <summary>Clamps Admin slider and number input to the API lookback range.</summary>
  private void SetLookback(int days) => _lookbackDays = NetSuiteLookback.Clamp(days);

  private void OnLookbackSliderInput(ChangeEventArgs args)
  {
    if (int.TryParse(Convert.ToString(args.Value), out var days))
    {
      SetLookback(days);
    }
  }

  private void OnLookbackNumberChange(ChangeEventArgs args) => OnLookbackSliderInput(args);

  /// <summary>
  /// Setup is a convenience banner. Never block the admin page on it — Railway/proxy
  /// stalls on GET /api/netsuite/setup were leaving this screen on "Loading administration...".
  /// </summary>
  private static readonly TimeSpan NetSuiteSetupLoadTimeout = TimeSpan.FromSeconds(8);

  protected override async Task OnInitializedAsync()
  {
    await AuthState.InitializeAsync();

    if (!AuthState.IsAuthenticated)
    {
      Navigation.NavigateTo("/login");
      return;
    }

    if (!AuthState.CanAccessAdminDashboard())
    {
      _accessDenied = true;
      _isLoading = false;
      return;
    }

    // Accounts first, then paint, then setup. Task.WhenAll hid the whole page when setup hung.
    await LoadUsersAsync();
    await InvokeAsync(StateHasChanged);

    await LoadNetSuiteSetupAsync();

    if (_netSuiteSetup?.LastSync.State == "Running")
    {
      // Resume the bar immediately; do not await here or OnInitialized would freeze until the import ends.
      _syncProgress = _netSuiteSetup.LastSync;
      _netSuiteBusy = true;
      _ = InvokeAsync(WatchRunningSyncAsync);
    }
  }

  private UserEditState GetEditState(string email)
  {
    if (!_editStates.TryGetValue(email, out var state))
    {
      var user = _users.FirstOrDefault(u => string.Equals(u.Email, email, StringComparison.OrdinalIgnoreCase));
      state = new UserEditState { Role = user?.Role ?? Roles.Sales };
      _editStates[email] = state;
    }

    return state;
  }

  private async Task LoadUsersAsync()
  {
    _isLoading = true;
    _pageError = null;

    try
    {
      var users = await AdminApi.GetUsersAsync();
      _users.Clear();
      _users.AddRange(users);
      _editStates.Clear();

      foreach (var user in _users)
      {
        _editStates[user.Email] = new UserEditState { Role = user.Role };
      }
    }
    catch (Exception ex)
    {
      _pageError = ex.Message;
    }
    finally
    {
      _isLoading = false;
    }
  }

  /// <summary>
  /// Fetches configured / last-sync status with a short timeout. Failures stay on the
  /// NetSuite panel so the accounts table can still render.
  /// </summary>
  private async Task LoadNetSuiteSetupAsync()
  {
    try
    {
      using var timeout = new CancellationTokenSource(NetSuiteSetupLoadTimeout);
      _netSuiteSetup = await AdminApi.GetNetSuiteSetupAsync(timeout.Token);

      if (_netSuiteSetup.LastSync.Result is not null)
      {
        _netSuiteSync = _netSuiteSetup.LastSync.Result;
      }

      _lookbackMin = _netSuiteSetup.LookbackDaysMin > 0 ? _netSuiteSetup.LookbackDaysMin : NetSuiteLookback.MinDays;
      _lookbackMax = _netSuiteSetup.LookbackDaysMax > 0 ? _netSuiteSetup.LookbackDaysMax : NetSuiteLookback.MaxDays;
      SetLookback(_netSuiteSetup.SuggestedLookbackDays > 0
        ? _netSuiteSetup.SuggestedLookbackDays
        : NetSuiteLookback.FirstImportDays);
    }
    catch (Exception ex)
    {
      _netSuiteError = ex.Message;
    }
  }

  /// <summary>
  /// Formats last-sync state for the status banner (idle / running / completed).
  /// </summary>
  private static string FormatLastSync(NetSuiteSyncStatusDto lastSync)
  {
    return lastSync.State switch
    {
      "Running" => lastSync.StartedAt is { } started
        ? $"Last sync: in progress (started {started.LocalDateTime:g})."
        : "Last sync: in progress.",
      "Succeeded" => lastSync.CompletedAt is { } succeededAt
        ? $"Last sync: succeeded at {succeededAt.LocalDateTime:g}."
        : "Last sync: succeeded.",
      "Failed" => lastSync.CompletedAt is { } failedAt
        ? $"Last sync: failed at {failedAt.LocalDateTime:g}."
        : "Last sync: failed.",
      _ => lastSync.Message
    };
  }

  private async Task SaveUserAsync(string email)
  {
    var edit = GetEditState(email);
    edit.Error = null;
    edit.IsBusy = true;
    _statusMessage = null;

    try
    {
      var user = _users.First(u => string.Equals(u.Email, email, StringComparison.OrdinalIgnoreCase));

      if (!string.Equals(user.Role, edit.Role, StringComparison.OrdinalIgnoreCase))
      {
        var (roleOk, roleError) = await AdminApi.UpdateRoleAsync(email, edit.Role);
        if (!roleOk)
        {
          edit.Error = roleError;
          return;
        }
      }

      if (!string.IsNullOrWhiteSpace(edit.Password) || !string.IsNullOrWhiteSpace(edit.ConfirmPassword))
      {
        var (passwordOk, passwordError) = await AdminApi.UpdatePasswordAsync(
          email,
          edit.Password,
          edit.ConfirmPassword);

        if (!passwordOk)
        {
          edit.Error = passwordError;
          return;
        }

        edit.Password = string.Empty;
        edit.ConfirmPassword = string.Empty;
      }

      _statusMessage = $"Saved changes for {email}.";
      await LoadUsersAsync();
    }
    finally
    {
      edit.IsBusy = false;
    }
  }

  private async Task DeleteUserAsync(string email)
  {
    var edit = GetEditState(email);
    edit.Error = null;
    edit.IsBusy = true;
    _statusMessage = null;

    try
    {
      var (success, error) = await AdminApi.DeleteUserAsync(email);
      if (!success)
      {
        edit.Error = error;
        return;
      }

      _statusMessage = $"Deleted account {email}.";
      await LoadUsersAsync();
    }
    finally
    {
      edit.IsBusy = false;
    }
  }

  private async Task TestNetSuiteConnectionAsync()
  {
    _netSuiteBusy = true;
    _testingConnection = true;
    _syncProgress = null;
    _netSuiteError = null;
    _netSuiteConnection = null;

    try
    {
      _netSuiteConnection = await AdminApi.TestNetSuiteConnectionAsync();
    }
    catch (Exception ex)
    {
      _netSuiteError = ex.Message;
    }
    finally
    {
      _testingConnection = false;
      _netSuiteBusy = false;
    }
  }

  private async Task SyncNetSuiteDataAsync()
  {
    _netSuiteBusy = true;
    _testingConnection = false;
    _netSuiteError = null;
    _netSuiteSync = null;
    _statusMessage = null;
    _syncProgress = new NetSuiteSyncStatusDto
    {
      State = "Running",
      Message = "NetSuite sync started.",
      CurrentStep = "starting",
      CompletedSteps = 0,
      TotalSteps = 8,
      LookbackDays = _lookbackDays,
      StartedAt = DateTimeOffset.UtcNow
    };

    try
    {
      var start = await AdminApi.StartNetSuiteSyncAsync(NetSuiteLookback.Clamp(_lookbackDays));
      _syncProgress = start;
      if (start.State == "Failed" && start.Result is null)
      {
        _netSuiteError = start.Message;
        return;
      }

      _statusMessage = $"NetSuite sync gestart ({_lookbackDays} dagen lookback). Een korte lookback is sneller; 365 dagen is voor een eerste import of backfill.";
      await WatchRunningSyncAsync();
    }
    catch (TaskCanceledException ex) when (!ex.CancellationToken.IsCancellationRequested)
    {
      _netSuiteError = "De verbinding met de API werd verbroken (time-out). De sync kan nog op de achtergrond draaien; vernieuw de pagina over een paar minuten.";
    }
    catch (Exception ex)
    {
      _netSuiteError = ex.Message;
    }
    finally
    {
      _netSuiteBusy = false;
      _testingConnection = false;
    }
  }

  /// <summary>
  /// Polls /api/netsuite/sync/status until the background import finishes, then refreshes setup.
  /// Re-renders each poll so the progress bar moves while a long step (invoices) is still running.
  /// </summary>
  private async Task WatchRunningSyncAsync()
  {
    _netSuiteBusy = true;
    _testingConnection = false;

    try
    {
      while (true)
      {
        var status = await AdminApi.GetNetSuiteSyncStatusAsync();
        _syncProgress = status;
        await InvokeAsync(StateHasChanged);

        if (status.State is not "Running")
        {
          _netSuiteSync = status.Result ?? new NetSuiteSyncResultDto
          {
            Success = false,
            Message = status.Message,
            CompletedAt = status.CompletedAt ?? DateTimeOffset.UtcNow
          };

          if (_netSuiteSync.Success)
          {
            _statusMessage = "NetSuite data imported successfully.";
          }

          break;
        }

        await Task.Delay(TimeSpan.FromSeconds(2));
      }

      // Refresh the configured / last-sync banner after the run completes.
      _netSuiteSetup = await AdminApi.GetNetSuiteSetupAsync();
    }
    finally
    {
      _netSuiteBusy = false;
      _testingConnection = false;
    }
  }

  private sealed class UserEditState
  {
    public string Role { get; set; } = Roles.Sales;

    public string Password { get; set; } = string.Empty;

    public string ConfirmPassword { get; set; } = string.Empty;

    public string? Error { get; set; }

    public bool IsBusy { get; set; }
  }
}
