@page "/goals"
@layout DashboardLayout
@using TebiDashboard.Shared.Dtos
@using TebiDashboard.Shared.Periods
@inject DashboardApiClient ApiClient
@inject IAuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Goals — TEBI Dashboard</PageTitle>

<div class="goals-page">
    <header class="goals-page__header">
        <h1>Goals</h1>
        <p class="goals-page__subtitle">Track company and item targets per quarter</p>
    </header>

    <section class="goals-page__filters" aria-label="Goal period filters">
        <label class="goals-page__filter">
            <span>Year</span>
            <select @bind="_selectedYear" @bind:after="LoadGoalsAsync">
                @foreach (var year in _yearOptions)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </label>

        <label class="goals-page__filter">
            <span>Quarter</span>
            <select @bind="_selectedPeriod" @bind:after="LoadGoalsAsync">
                <option value="">All quarters</option>
                <option value="Q1">Q1</option>
                <option value="Q2">Q2</option>
                <option value="Q3">Q3</option>
                <option value="Q4">Q4</option>
            </select>
        </label>
    </section>

    @if (_isLoading)
    {
        <p class="goals-page__status">Loading goals...</p>
    }
    else if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else if (_goals.Count == 0)
    {
        <p class="goals-page__status">No goals found for the selected period.</p>
    }
    else
    {
        <section class="goals-page__section">
            <h2>Company revenue goals (@_companyGoals.Count)</h2>
            @if (_companyGoals.Count == 0)
            {
                <p class="goals-page__empty">No company-level goals in this period.</p>
            }
            else
            {
                <div class="goals-page__chart-wrap">
                    <BarChart Items="_companyChartItems"
                              AriaLabel="Company goal progress chart"
                              EmptyMessage="No company goals to chart."
                              UseCompactCurrency="true" />
                </div>

                <div class="goals-page__cards">
                    @foreach (var goal in _companyGoals)
                    {
                        <GoalProgressCard Goal="goal"
                                          Title="@($"{goal.Period} {goal.Year} revenue")"
                                          UseCurrency="true" />
                    }
                </div>
            }
        </section>

        <section class="goals-page__section">
            <h2>Item goals (@_itemGoals.Count)</h2>
            @if (_itemGoals.Count == 0)
            {
                <p class="goals-page__empty">No item-level goals in this period.</p>
            }
            else
            {
                <div class="goals-page__cards">
                    @foreach (var goal in _itemGoals)
                    {
                        <GoalProgressCard Goal="goal"
                                          Title="@FormatItemGoalTitle(goal)"
                                          UseCurrency="false" />
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.UtcNow);

    private IReadOnlyList<GoalDto> _goals = [];
    private IReadOnlyList<GoalDto> _companyGoals = [];
    private IReadOnlyList<GoalDto> _itemGoals = [];
    private IReadOnlyList<ChartBarItem> _companyChartItems = [];

    private IReadOnlyList<int> _yearOptions =
    [
        Today.Year - 1,
        Today.Year,
        Today.Year + 1
    ];

    private int _selectedYear = Today.Year;
    private string _selectedPeriod = PeriodHelper.GetQuarter(Today);

    // Show quarter on item cards when multiple quarters are listed together.
    private bool _showQuarterOnItemGoals;

    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadGoalsAsync();
    }

    private async Task LoadGoalsAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _goals = await ApiClient.GetGoalsAsync(
                _selectedYear,
                string.IsNullOrWhiteSpace(_selectedPeriod) ? null : _selectedPeriod);

            _showQuarterOnItemGoals = string.IsNullOrWhiteSpace(_selectedPeriod);

            _companyGoals = _goals.Where(goal => string.IsNullOrWhiteSpace(goal.ItemId)).ToList();
            _itemGoals = _goals.Where(goal => !string.IsNullOrWhiteSpace(goal.ItemId)).ToList();

            // Chart actual progress per company goal quarter.
            _companyChartItems = _companyGoals
                .Select(goal => new ChartBarItem
                {
                    Label = goal.Period,
                    Value = goal.ActualValue
                })
                .ToList();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load goals: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string FormatItemGoalTitle(GoalDto goal)
    {
        var itemLabel = goal.ItemName ?? goal.ItemId ?? "Item";

        return _showQuarterOnItemGoals
            ? $"{itemLabel} ({goal.Period} {goal.Year})"
            : itemLabel;
    }
}
