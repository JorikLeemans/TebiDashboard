@page "/inventory"
@layout DashboardLayout
@using TebiDashboard.Shared.Dtos
@using TebiDashboard.UI.Helpers
@inject DashboardApiClient ApiClient
@inject IAuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Inventory — TEBI Dashboard</PageTitle>

<div class="inventory-page">
    <header class="inventory-page__header">
        <h1>Inventory</h1>
        <p class="inventory-page__subtitle">All items currently in stock</p>
    </header>

    @if (_isLoading)
    {
        <p class="inventory-page__status">Loading inventory...</p>
    }
    else if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else if (_items.Count == 0)
    {
        <p class="inventory-page__status">No inventory items found.</p>
    }
    else
    {
        <ListSearchBar Placeholder="Name, barcode, or item ID"
                       SearchText="@_searchText"
                       SearchTextChanged="OnSearchTextChanged"
                       FilteredCount="@FilteredItems.Count"
                       TotalCount="@_items.Count"
                       ShowClear="@HasActiveFilters"
                       OnClear="ClearFilters">
            <AdditionalFilters>
                <label class="list-search__filter">
                    <span class="list-search__label">Stock status</span>
                    <select class="list-search__select" value="@_stockFilter" @onchange="OnStockFilterChanged">
                        <option value="all">All items</option>
                        <option value="low">Low stock only</option>
                        <option value="ok">OK stock only</option>
                    </select>
                </label>
            </AdditionalFilters>
        </ListSearchBar>

        @if (FilteredItems.Count == 0)
        {
            <p class="inventory-page__status">No items match your filters.</p>
        }
        else
        {
            <ListPaginationBar PageSize="@_pageSize"
                               PageSizeChanged="OnPageSizeChanged"
                               CurrentPage="@GetSafeCurrentPage()"
                               CurrentPageChanged="OnCurrentPageChanged"
                               TotalItems="@FilteredItems.Count" />

            <div class="inventory-table-wrap">
                <table class="inventory-table" aria-label="Inventory items">
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col">Barcode</th>
                            <th scope="col">On hand</th>
                            <th scope="col">Reorder point</th>
                            <th scope="col">Recent sales</th>
                            <StatusColumnHeader Kind="StatusLegendKind.InventoryStock" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedItems)
                        {
                            <tr class="inventory-table__row" @onclick="() => OpenItem(item.ItemId)" tabindex="0"
                                @onkeydown="(e) => HandleRowKeyDown(e, item.ItemId)">
                                <td class="inventory-table__name">@item.ItemName</td>
                                <td><code>@item.Barcode</code></td>
                                <td>@item.QuantityOnHand.ToString("N0")</td>
                                <td>@(item.ReorderPoint?.ToString("N0") ?? "—")</td>
                                <td>@item.RecentSalesVolume.ToString("N0")</td>
                                <td>
                                    @if (item.IsLowStock)
                                    {
                                        <span class="inventory-badge inventory-badge--alert">Low stock</span>
                                    }
                                    else
                                    {
                                        <span class="inventory-badge inventory-badge--ok">OK</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<InventoryItemDto> _items = [];
    private string _searchText = string.Empty;
    private string _stockFilter = "all";
    private int _pageSize = ListPagination.DefaultPageSize;
    private int _currentPage = 1;
    private bool _isLoading = true;
    private string? _error;

    private List<InventoryItemDto> FilteredItems => _items.Where(MatchesFilters).ToList();

    private List<InventoryItemDto> PagedItems =>
        ListPagination.GetPageSlice(FilteredItems, GetSafeCurrentPage(), _pageSize);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText) || _stockFilter != "all";

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _items = await ApiClient.GetInventoryItemsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load inventory: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool MatchesFilters(InventoryItemDto item)
    {
        if (!EntityListFilters.MatchesSearch(_searchText, item.ItemName, item.Barcode, item.ItemId))
        {
            return false;
        }

        return _stockFilter switch
        {
            "low" => item.IsLowStock,
            "ok" => !item.IsLowStock,
            _ => true
        };
    }

    private void OnSearchTextChanged(string value)
    {
        _searchText = value;
        ResetPage();
    }

    private void OnStockFilterChanged(ChangeEventArgs args)
    {
        _stockFilter = args.Value?.ToString() ?? "all";
        ResetPage();
    }

    private void OnPageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        ResetPage();
    }

    private void OnCurrentPageChanged(int page)
    {
        _currentPage = page;
    }

    private int GetSafeCurrentPage()
    {
        var totalPages = ListPagination.GetTotalPages(FilteredItems.Count, _pageSize);
        return ListPagination.ClampPage(_currentPage, totalPages);
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _stockFilter = "all";
        ResetPage();
    }

    private void ResetPage()
    {
        _currentPage = 1;
    }

    private void OpenItem(string itemId) => Navigation.NavigateTo($"/inventory/{Uri.EscapeDataString(itemId)}");

    private void HandleRowKeyDown(KeyboardEventArgs args, string itemId)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenItem(itemId);
        }
    }
}
