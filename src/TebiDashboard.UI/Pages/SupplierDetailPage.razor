@page "/suppliers/{SupplierId}"
@layout DashboardLayout
@using TebiDashboard.Shared.Dtos
@inject DashboardApiClient ApiClient
@inject IPeriodFilterService InjectedPeriodFilter
@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(_detail?.Supplier.Name ?? "Supplier detail") — TEBI Dashboard</PageTitle>

<div class="supplier-detail">
    <nav class="supplier-detail__nav">
        <a href="/suppliers" class="supplier-detail__back">← Back to suppliers</a>
    </nav>

    @if (_isInitialLoad && _isLoading)
    {
        <p class="supplier-detail__status">Loading supplier details...</p>
    }
    else if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else if (_detail is null)
    {
        <p class="supplier-detail__status">Supplier not found.</p>
    }
    else
    {
        <header class="supplier-detail__header">
            <div>
                <h1>@_detail.Supplier.Name</h1>
                <p class="supplier-detail__meta">
                    <span>ID: <code>@_detail.Supplier.SupplierId</code></span>
                    <span>City: @_detail.Supplier.City</span>
                    <span>Contact: @_detail.Supplier.ContactEmail</span>
                </p>
            </div>
        </header>

        <section class="supplier-detail__kpi-grid" aria-label="Supplier summary">
            <article class="supplier-detail__kpi">
                <h2>Total purchased</h2>
                <p>@EuroFormatting.FormatWhole(_detail.TotalPurchased)</p>
                @* Total purchased combines expense entries and purchase order amounts. *@
                <p class="supplier-detail__kpi-hint">Expenses + purchase order amounts</p>
            </article>
            <article class="supplier-detail__kpi">
                <h2>Expense entries</h2>
                <p>@_detail.Expenses.Count</p>
            </article>
            <article class="supplier-detail__kpi">
                <h2>Purchase orders</h2>
                <p>@_detail.PurchaseOrders.Count</p>
            </article>
            <article class="supplier-detail__kpi">
                <h2>Purchased items</h2>
                <p>@_detail.PurchasedItems.Count</p>
            </article>
            <article class="supplier-detail__kpi">
                <h2>Period</h2>
                <p>@_detail.PeriodFrom.ToString("d") – @_detail.PeriodTo.ToString("d")</p>
            </article>
        </section>

        <section class="supplier-detail__section">
            <h2>Purchased items in period</h2>
            @if (_detail.PurchasedItems.Count == 0)
            {
                <p class="supplier-detail__empty">No purchased items linked to this supplier in the selected period.</p>
            }
            else
            {
                <table class="supplier-detail__table" aria-label="Purchased items">
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col">Total qty open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _detail.PurchasedItems)
                        {
                            <tr class="supplier-detail__link-row" @onclick="() => OpenItem(item.ItemId)" tabindex="0">
                                @* Item name comes from the inventory item; the id is the fallback when it cannot be resolved. *@
                                <td>@ItemLabel(item.ItemName, item.ItemId)</td>
                                <td>@item.TotalQuantityOpen.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="supplier-detail__section">
            <h2>Purchase orders in period</h2>
            @if (_detail.PurchaseOrders.Count == 0)
            {
                <p class="supplier-detail__empty">No open purchase orders linked to this supplier in the selected period.</p>
            }
            else
            {
                <table class="supplier-detail__table" aria-label="Supplier purchase orders">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Order</th>
                            <th scope="col">Item</th>
                            <th scope="col">Qty open</th>
                            <th scope="col">Amount</th>
                            <StatusColumnHeader Kind="StatusLegendKind.PurchaseOrder" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _detail.PurchaseOrders)
                        {
                            <tr class="supplier-detail__link-row" @onclick="() => OpenItem(order.ItemId)" tabindex="0">
                                <td>@order.TransactionDate.ToString("d")</td>
                                <td><code>@order.TransactionId</code></td>
                                <td>@ItemLabel(order.ItemName, order.ItemId)</td>
                                <td>@order.QuantityOpen.ToString("N0")</td>
                                <td>@EuroFormatting.FormatWhole(order.Amount)</td>
                                <td>@order.Status</td>
                            </tr>
                        }
                    </tbody>
                    @if (_detail.PurchaseOrders.Count > 0)
                    {
                        <tfoot>
                            <tr>
                                <th scope="row" colspan="4">Total</th>
                                <td>@EuroFormatting.FormatWhole(PurchaseOrdersTotal)</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            }
        </section>

        <section class="supplier-detail__section">
            <h2>Expenses in period</h2>
            @if (_detail.Expenses.Count == 0)
            {
                <p class="supplier-detail__empty">No expenses recorded for this supplier in the selected period.</p>
            }
            else
            {
                <table class="supplier-detail__table" aria-label="Supplier expenses">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Category</th>
                            <th scope="col">Vendor</th>
                            <th scope="col">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in _detail.Expenses)
                        {
                            <tr>
                                <td>@expense.Date.ToString("d")</td>
                                <td>@expense.Category</td>
                                <td>@ExpensePartyName(expense)</td>
                                <td>@EuroFormatting.FormatWhole(expense.Amount)</td>
                            </tr>
                        }
                    </tbody>
                    @if (_detail.Expenses.Count > 0)
                    {
                        <tfoot>
                            <tr>
                                <th scope="row" colspan="3">Total</th>
                                <td>@EuroFormatting.FormatWhole(ExpensesTotal)</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            }
        </section>
    }
</div>

@code {
    [CascadingParameter(Name = "PeriodFilter")]
    private IPeriodFilterService? CascadedPeriodFilter { get; set; }

    private IPeriodFilterService PeriodFilter => CascadedPeriodFilter ?? InjectedPeriodFilter;

    private readonly PeriodFilterSubscription _periodSubscription = new();
    private readonly PeriodFilterReload _periodReload = new();

    [Parameter]
    public string SupplierId { get; set; } = string.Empty;

    private SupplierDetailDto? _detail;
    private bool _isLoading = true;
    private bool _isInitialLoad = true;
    private string? _error;

    // Footer totals show how expenses and purchase orders add up to Total purchased.
    private decimal ExpensesTotal => _detail?.Expenses.Sum(row => row.Amount) ?? 0m;

    // Hide a bare NetSuite internal id when the name never arrived.
    private static string ItemLabel(string? itemName, string itemId) =>
        !string.IsNullOrWhiteSpace(itemName)
            ? itemName
            : itemId.Length > 0 && itemId.All(char.IsDigit) ? string.Empty : itemId;

    // Vendor text is the name on the bill. The supplier master name covers rows that only
    // have a supplier id, and the id itself is the last resort so the cell is never blank.
    private static string ExpensePartyName(ExpenseDto expense)
    {
        if (!string.IsNullOrWhiteSpace(expense.VendorName))
        {
            return expense.VendorName;
        }

        if (!string.IsNullOrWhiteSpace(expense.SupplierName))
        {
            return expense.SupplierName;
        }

        return expense.SupplierId ?? string.Empty;
    }
    private decimal PurchaseOrdersTotal => _detail?.PurchaseOrders.Sum(order => order.Amount) ?? 0m;

    protected override void OnParametersSet()
    {
        _periodSubscription.Bind(CascadedPeriodFilter, InjectedPeriodFilter, OnPeriodChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadDetailAsync(_periodReload.BeginReload(), showLoadingSpinner: true);
    }

    private void OnPeriodChanged()
    {
        _ = InvokeAsync(ReloadDetailAsync);
    }

    private async Task ReloadDetailAsync()
    {
        var generation = _periodReload.BeginReload();
        await LoadDetailAsync(generation, showLoadingSpinner: false);

        if (!_periodReload.IsCurrent(generation))
        {
            return;
        }

        StateHasChanged();
    }

    private async Task LoadDetailAsync(int generation, bool showLoadingSpinner)
    {
        var from = PeriodFilter.From;
        var to = PeriodFilter.To;

        if (showLoadingSpinner)
        {
            _isLoading = true;
            _error = null;
        }

        try
        {
            var detail = await ApiClient.GetSupplierDetailAsync(SupplierId, from, to);

            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _detail = detail;

            if (_detail is null)
            {
                _error = $"No supplier found with id '{SupplierId}'.";
            }
        }
        catch (Exception ex)
        {
            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _error = $"Failed to load supplier details: {ex.Message}";
        }
        finally
        {
            if (showLoadingSpinner)
            {
                _isLoading = false;
                _isInitialLoad = false;
            }
        }
    }

    private void OpenItem(string itemId) => Navigation.NavigateTo($"/inventory/{Uri.EscapeDataString(itemId)}");

    public void Dispose()
    {
        _periodSubscription.Dispose();
    }
}
