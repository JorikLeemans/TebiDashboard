@page "/dashboard"
@layout DashboardLayout
@using TebbiDashboard.Shared.Dtos
@inject DashboardApiClient ApiClient
@inject IAuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>TEBI Dashboard</PageTitle>

<div class="dashboard">
    <h1>TEBI Dashboard</h1>

    @if (_isLoading)
    {
        <p>Loading dashboard...</p>
    }
    else if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    else if (_summary is not null)
    {
        <div class="kpi-grid">
            <div class="kpi-card">
                <h3>Revenue</h3>
                <p class="kpi-value">@_summary.Revenue.ToString("C0")</p>
                <span class="trend">@_summary.RevenueTrend</span>
            </div>
            <div class="kpi-card">
                <h3>Sales volume</h3>
                <p class="kpi-value">@_summary.SalesVolume.ToString("N0")</p>
            </div>
            <div class="kpi-card">
                <h3>Goal progress</h3>
                <p class="kpi-value">@_summary.GoalPercentage.ToString("F1")%</p>
            </div>
            <a href="/inventory" class="kpi-card alert kpi-card--link">
                <h3>Low stock alerts</h3>
                <p class="kpi-value">@_summary.LowStockAlertCount</p>
                <span class="kpi-card__hint">View inventory →</span>
            </a>
        </div>
        <p class="period">Period: @_summary.PeriodFrom.ToString("d") – @_summary.PeriodTo.ToString("d")</p>
    }
</div>

@code {
  private DashboardSummaryDto? _summary;
  private bool _isLoading = true;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    await AuthState.InitializeAsync();

    if (!AuthState.IsAuthenticated)
    {
      Navigation.NavigateTo("/login");
      return;
    }

    try
    {
      _summary = await ApiClient.GetSummaryAsync();
    }
    catch (Exception ex)
    {
      _error = $"Failed to load dashboard: {ex.Message}";
    }
    finally
    {
      _isLoading = false;
    }
  }
}
