# Build stage for the API
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/TebiDashboard.Shared/TebiDashboard.Shared.csproj src/TebiDashboard.Shared/
COPY src/TebiDashboard.Application/TebiDashboard.Application.csproj src/TebiDashboard.Application/
COPY src/TebiDashboard.Infrastructure/TebiDashboard.Infrastructure.csproj src/TebiDashboard.Infrastructure/
COPY src/TebiDashboard.Api/TebiDashboard.Api.csproj src/TebiDashboard.Api/

RUN dotnet restore src/TebiDashboard.Api/TebiDashboard.Api.csproj

COPY src/ src/
RUN dotnet publish src/TebiDashboard.Api/TebiDashboard.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# Npgsql may load Kerberos/GSSAPI on Linux; install the library to avoid connection warnings.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 8080

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "TebiDashboard.Api.dll"]
