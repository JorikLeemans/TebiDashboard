@page "/customers/{CustomerId}"
@layout DashboardLayout
@using TebiDashboard.Shared.Dtos
@inject DashboardApiClient ApiClient
@inject IPeriodFilterService InjectedPeriodFilter
@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(_detail?.Customer.Name ?? "Customer detail") — TEBI Dashboard</PageTitle>

<div class="customer-detail">
    <nav class="customer-detail__nav">
        <a href="/customers" class="customer-detail__back">← Back to customers</a>
    </nav>

    @if (_isInitialLoad && _isLoading)
    {
        <p class="customer-detail__status">Loading customer details...</p>
    }
    else if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else if (_detail is null)
    {
        <p class="customer-detail__status">Customer not found.</p>
    }
    else
    {
        <header class="customer-detail__header">
            <div>
                <h1>@_detail.Customer.Name</h1>
                <p class="customer-detail__meta">
                    <span>ID: <code>@_detail.Customer.CustomerId</code></span>
                    <span>City: @_detail.Customer.City</span>
                    <span>Category: @_detail.Customer.Category</span>
                    <span>Subcategory: @_detail.Customer.Subcategory</span>
                    <span>Contact: @_detail.Customer.ContactEmail</span>
                </p>
            </div>
        </header>

        <section class="customer-detail__kpi-grid" aria-label="Customer summary">
            <article class="customer-detail__kpi">
                <h2>Total spent</h2>
                <p>@EuroFormatting.FormatWhole(_detail.TotalSpent)</p>
                @* Total spent is the sum of still-open sales order amounts. *@
                <p class="customer-detail__kpi-hint">Sum of open sales order amounts below</p>
            </article>
            <article class="customer-detail__kpi">
                <h2>Invoices</h2>
                <p>@InvoiceGroups.Count</p>
            </article>
            <article class="customer-detail__kpi">
                <h2>Sales orders</h2>
                <p>@OrderGroups.Count</p>
            </article>
            <article class="customer-detail__kpi">
                <h2>Period</h2>
                <p>@_detail.PeriodFrom.ToString("d") – @_detail.PeriodTo.ToString("d")</p>
            </article>
        </section>

        @* Revenue is grouped by invoice. Click a row to expand its item lines. *@
        <section class="customer-detail__section">
            <h2>Revenue in period</h2>
            @if (_detail.Revenue.Count == 0)
            {
                <p class="customer-detail__empty">No revenue recorded for this customer in the selected period.</p>
            }
            else
            {
                <table class="customer-detail__table" aria-label="Customer revenue">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Invoice</th>
                            <th scope="col">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in InvoiceGroups)
                        {
                            var expanded = IsInvoiceExpanded(invoice.Key);
                            <tr class="customer-detail__invoice-row"
                                @onclick="() => ToggleInvoice(invoice.Key)"
                                tabindex="0"
                                aria-expanded="@expanded"
                                @onkeydown="(args) => HandleInvoiceKeyDown(args, invoice.Key)">
                                <td>@invoice.Date.ToString("d")</td>
                                <td>
                                    <span class="customer-detail__invoice-toggle" aria-hidden="true">@(expanded ? "▼" : "▶")</span>
                                    @invoice.InvoiceLabel
                                </td>
                                <td>@EuroFormatting.Format(invoice.TotalAmount)</td>
                            </tr>
                            @if (expanded)
                            {
                                @foreach (var line in invoice.Lines)
                                {
                                    <tr class="customer-detail__line-row">
                                        <td>@line.Date.ToString("d")</td>
                                        <td>@LineDetailLabel(line)</td>
                                        <td>@EuroFormatting.Format(line.Amount)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                    @if (InvoiceGroups.Count > 0)
                    {
                        <tfoot>
                            <tr>
                                <th scope="row" colspan="2">Total</th>
                                <td>@EuroFormatting.Format(RevenueTotal)</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            }
        </section>

        @* Open orders are grouped by sales order. Click a row to expand its item lines. *@
        <section class="customer-detail__section">
            <h2>Open sales orders</h2>
            @if (_detail.SalesOrders.Count == 0)
            {
                <p class="customer-detail__empty">No open sales orders linked to this customer.</p>
            }
            else
            {
                <table class="customer-detail__table" aria-label="Customer sales orders">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Order</th>
                            <th scope="col">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in OrderGroups)
                        {
                            var expanded = IsSalesOrderExpanded(order.Key);
                            <tr class="customer-detail__invoice-row"
                                @onclick="() => ToggleSalesOrder(order.Key)"
                                tabindex="0"
                                aria-expanded="@expanded"
                                @onkeydown="(args) => HandleSalesOrderKeyDown(args, order.Key)">
                                <td>@order.Date.ToString("d")</td>
                                <td>
                                    <span class="customer-detail__invoice-toggle" aria-hidden="true">@(expanded ? "▼" : "▶")</span>
                                    <code>@order.OrderLabel</code>
                                </td>
                                <td>@EuroFormatting.Format(order.TotalAmount)</td>
                            </tr>
                            @if (expanded)
                            {
                                @foreach (var line in order.Lines)
                                {
                                    <tr class="customer-detail__line-row customer-detail__link-row"
                                        @onclick="() => OpenItem(line.ItemId)"
                                        @onclick:stopPropagation="true"
                                        tabindex="0">
                                        <td>@line.TransactionDate.ToString("d")</td>
                                        <td>@SalesOrderLineLabel(line)</td>
                                        <td>@EuroFormatting.Format(line.Amount)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                    @if (OrderGroups.Count > 0)
                    {
                        <tfoot>
                            <tr>
                                <th scope="row" colspan="2">Total</th>
                                <td>@EuroFormatting.Format(SalesOrdersTotal)</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            }
        </section>
    }
</div>

@code {
    [CascadingParameter(Name = "PeriodFilter")]
    private IPeriodFilterService? CascadedPeriodFilter { get; set; }

    private IPeriodFilterService PeriodFilter => CascadedPeriodFilter ?? InjectedPeriodFilter;

    private readonly PeriodFilterSubscription _periodSubscription = new();
    private readonly PeriodFilterReload _periodReload = new();

    [Parameter]
    public string CustomerId { get; set; } = string.Empty;

    private CustomerDetailDto? _detail;
    private bool _isLoading = true;
    private bool _isInitialLoad = true;
    private string? _error;
    private readonly HashSet<string> _expandedInvoices = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expandedSalesOrders = new(StringComparer.OrdinalIgnoreCase);

    // One row per invoice; click a row to reveal its lines.
    private IReadOnlyList<InvoiceRevenueGroup> InvoiceGroups =>
        _detail is null ? [] : InvoiceRevenueGroups.From(_detail.Revenue);

    // One row per sales order; click a row to reveal its lines.
    private IReadOnlyList<SalesOrderGroup> OrderGroups =>
        _detail is null ? [] : SalesOrderGroups.From(_detail.SalesOrders);

    // Footer totals make it easy to compare revenue with sales orders in the same period.
    private decimal RevenueTotal => _detail?.Revenue.Sum(row => row.Amount) ?? 0m;

    // Revenue is stored by product group. ItemName is the linked inventory item so the row
    // says what it is; fall back to the item id, then the product group id.
    private static string RevenueItemLabel(RevenueDto row)
    {
        if (!string.IsNullOrWhiteSpace(row.ItemName))
        {
            return row.ItemName;
        }

        if (!string.IsNullOrWhiteSpace(row.ItemId))
        {
            return row.ItemId;
        }

        return row.ProductGroupId ?? string.Empty;
    }

    // Expanded invoice lines show the article and artikelgroep on the invoice column.
    private static string LineDetailLabel(RevenueDto row)
    {
        var item = RevenueItemLabel(row);
        var group = ProductGroupLabel.For(row);
        if (string.IsNullOrWhiteSpace(group))
        {
            return item;
        }

        if (string.IsNullOrWhiteSpace(item))
        {
            return group;
        }

        return $"{item} · {group}";
    }

    private bool IsInvoiceExpanded(string key) => _expandedInvoices.Contains(key);

    private void ToggleInvoice(string key)
    {
        if (!_expandedInvoices.Add(key))
        {
            _expandedInvoices.Remove(key);
        }
    }

    private void HandleInvoiceKeyDown(KeyboardEventArgs args, string key)
    {
        if (args.Key is "Enter" or " ")
        {
            ToggleInvoice(key);
        }
    }

    private bool IsSalesOrderExpanded(string key) => _expandedSalesOrders.Contains(key);

    private void ToggleSalesOrder(string key)
    {
        if (!_expandedSalesOrders.Add(key))
        {
            _expandedSalesOrders.Remove(key);
        }
    }

    private void HandleSalesOrderKeyDown(KeyboardEventArgs args, string key)
    {
        if (args.Key is "Enter" or " ")
        {
            ToggleSalesOrder(key);
        }
    }

    // Expanded sales-order lines show the article, remaining qty, and status.
    private static string SalesOrderLineLabel(OpenTransactionDto line)
    {
        var item = ItemLabel(line.ItemName, line.ItemId);
        var quantity = line.QuantityOpen.ToString("N0");
        if (string.IsNullOrWhiteSpace(item))
        {
            return $"{quantity} open · {line.Status}";
        }

        return $"{item} · {quantity} open · {line.Status}";
    }

    // Hide a bare NetSuite internal id (digits only) when the name never arrived.
    private static string ItemLabel(string? itemName, string itemId) =>
        !string.IsNullOrWhiteSpace(itemName)
            ? itemName
            : itemId.Length > 0 && itemId.All(char.IsDigit) ? string.Empty : itemId;
    private decimal SalesOrdersTotal => _detail?.SalesOrders.Sum(order => order.Amount) ?? 0m;

    protected override void OnParametersSet()
    {
        _periodSubscription.Bind(CascadedPeriodFilter, InjectedPeriodFilter, OnPeriodChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadDetailAsync(_periodReload.BeginReload(), showLoadingSpinner: true);
    }

    private void OnPeriodChanged()
    {
        _ = InvokeAsync(ReloadDetailAsync);
    }

    private async Task ReloadDetailAsync()
    {
        var generation = _periodReload.BeginReload();
        await LoadDetailAsync(generation, showLoadingSpinner: false);

        if (!_periodReload.IsCurrent(generation))
        {
            return;
        }

        StateHasChanged();
    }

    private async Task LoadDetailAsync(int generation, bool showLoadingSpinner)
    {
        var from = PeriodFilter.From;
        var to = PeriodFilter.To;

        if (showLoadingSpinner)
        {
            _isLoading = true;
            _error = null;
        }

        try
        {
            var detail = await ApiClient.GetCustomerDetailAsync(CustomerId, from, to);

            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _detail = detail;
            _expandedInvoices.Clear();
            _expandedSalesOrders.Clear();

            if (_detail is null)
            {
                _error = $"No customer found with id '{CustomerId}'.";
            }
        }
        catch (Exception ex)
        {
            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _error = $"Failed to load customer details: {ex.Message}";
        }
        finally
        {
            if (showLoadingSpinner)
            {
                _isLoading = false;
                _isInitialLoad = false;
            }
        }
    }

    private void OpenItem(string itemId) => Navigation.NavigateTo($"/inventory/{Uri.EscapeDataString(itemId)}");

    public void Dispose()
    {
        _periodSubscription.Dispose();
    }
}
