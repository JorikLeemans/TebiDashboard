@using TebiDashboard.UI.Helpers

@* Status column header: legend on hover, and click-to-sort when a sort state is supplied. *@
@if (Sort is not null)
{
    <SortableHeader Column="@Column"
                    Label="@Label"
                    Sort="Sort"
                    ExtraTitle="@StatusLegends.GetTooltip(Kind)"
                    CssClass="status-column-header"
                    OnSorted="OnSorted" />
}
else
{
    <th scope="col"
        class="status-column-header"
        title="@StatusLegends.GetTooltip(Kind)"
        aria-label="@($"{Label}. {StatusLegends.GetTooltip(Kind)}")">
        @Label
    </th>
}

@code {
    [Parameter]
    public string Label { get; set; } = "Status";

    [Parameter]
    public StatusLegendKind Kind { get; set; }

    [Parameter]
    public ListSortState? Sort { get; set; }

    [Parameter]
    public string Column { get; set; } = "status";

    [Parameter]
    public EventCallback OnSorted { get; set; }
}
