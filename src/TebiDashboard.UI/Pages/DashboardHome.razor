@page "/dashboard"
@layout DashboardLayout
@using System.Globalization
@using TebiDashboard.Shared.Dtos
@using TebiDashboard.UI.Helpers
@inject DashboardApiClient ApiClient
@inject IPeriodFilterService InjectedPeriodFilter
@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>TEBI Dashboard</PageTitle>

<div class="dashboard">
    <h1>TEBI Dashboard</h1>

    @if (_isInitialLoad && _isLoading)
    {
        <p>Loading dashboard...</p>
    }
    else if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else if (_overview is not null)
    {
        <div class="kpi-grid">
            <div class="kpi-card">
                <h3>Revenue</h3>
                <p class="kpi-value">@EuroFormatting.FormatWhole(_overview.Summary.Revenue)</p>
                <span class="trend">@RevenueTrendText</span>
            </div>
            <div class="kpi-card">
                <h3>Sales volume</h3>
                <p class="kpi-value">@_overview.Summary.SalesVolume.ToString("N0")</p>
            </div>
            <a href="/goals" class="kpi-card kpi-card--link">
                <h3>Goal progress (@_goalPeriodLabel)</h3>
                <p class="kpi-value">@_quarterGoalPercentage.ToString("F1")%</p>
                <span class="kpi-card__hint">View goals →</span>
            </a>
            <a href="/inventory" class="kpi-card alert kpi-card--link">
                <h3>Low stock alerts</h3>
                <p class="kpi-value">@_overview.Summary.LowStockAlertCount</p>
                <span class="kpi-card__hint">View inventory →</span>
            </a>
        </div>

        @* Selected period against the two equal-length periods before it. *@
        <section class="dashboard-section">
            <h2>Trend</h2>
            <p class="dashboard-section__hint">The selected period and the two periods before it, each the same length.</p>
            @if (_overview.Trend.Count == 0)
            {
                <p class="dashboard-empty">No trend for this period.</p>
            }
            else
            {
                <BarChart Items="_trendChartItems"
                          AriaLabel="Revenue across recent periods"
                          EmptyMessage="No revenue in these periods." />
                <table class="dashboard-table" aria-label="Period trend">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Revenue</th>
                            <th>Expenses</th>
                            <th>Change</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < _overview.Trend.Count; index++)
                        {
                            var point = _overview.Trend[index];
                            decimal? previousRevenue = index == 0 ? null : _overview.Trend[index - 1].Revenue;
                            <tr>
                                <td>@TrendPeriodLabel(point)</td>
                                <td>@EuroFormatting.FormatWhole(point.Revenue)</td>
                                <td>@EuroFormatting.FormatWhole(point.Expenses)</td>
                                <td>@PeriodTrendWindows.DescribeChange(point.Revenue, previousRevenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @* Seller advice for this period. Purchasing keeps the full ranking on Bestsellers. *@
        <section class="dashboard-section">
            <h2>Popular articles</h2>
            <p class="dashboard-section__hint">What customers are buying in this period, so you can recommend it.</p>
            @if (_popularError is not null)
            {
                <p class="error" role="alert">@_popularError</p>
            }
            else if (_popularItems.Count == 0)
            {
                <p class="dashboard-empty">No popular articles in this period.</p>
            }
            else
            {
                <ol class="popular-list">
                    @foreach (var item in _popularItems)
                    {
                        <li class="popular-list__item">
                            <a class="dashboard-table__customer-link" href="/inventory/@Uri.EscapeDataString(item.ItemId)">@item.ItemName</a>
                            <span>@item.UnitsSold.ToString("N0") · @EuroFormatting.FormatWhole(item.SalesAmount)</span>
                        </li>
                    }
                </ol>
            }
        </section>

        <section class="dashboard-section">
            <h2>Revenue chart (@_revenueChartItems.Count days)</h2>
            <BarChart Items="_revenueChartItems"
                      AriaLabel="Revenue per day in selected period"
                      EmptyMessage="No revenue records in this period to chart." />
        </section>

        @* One row per invoice, same grouping as the customer page. Click a row to see its lines. *@
        <section class="dashboard-section">
            <h2>Sales in period (@DashboardHomePreview.TitleCount(SalesPreview.Count, SalesGroups.Count))</h2>
            @if (_overview.Revenue.Count == 0)
            {
                <p class="dashboard-empty">No revenue records in this period.</p>
            }
            else
            {
                <table class="dashboard-table" aria-label="Revenue in period">
                    <thead>
                        <tr>
                            <SortableHeader Column="date" Label="Date" Sort="_salesSort" />
                            <SortableHeader Column="invoice" Label="Invoice" Sort="_salesSort" />
                            <SortableHeader Column="customer" Label="Customer" Sort="_salesSort" />
                            <SortableHeader Column="amount" Label="Amount" Sort="_salesSort" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in SalesPreview)
                        {
                            var expanded = IsInvoiceExpanded(invoice.Key);
                            var customer = invoice.Lines[0];
                            <tr class="dashboard-table__group-row"
                                @onclick="() => ToggleInvoice(invoice.Key)"
                                tabindex="0"
                                aria-expanded="@expanded"
                                @onkeydown="(args) => HandleInvoiceKeyDown(args, invoice.Key)">
                                <td>@invoice.Date.ToString("d")</td>
                                <td>
                                    <span class="dashboard-table__toggle" aria-hidden="true">@(expanded ? "▼" : "▶")</span>
                                    <code>@invoice.InvoiceLabel</code>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(customer.CustomerId))
                                    {
                                        @CustomerLabel(customer)
                                    }
                                    else
                                    {
                                        <a class="dashboard-table__customer-link"
                                           href="@($"/customers/{Uri.EscapeDataString(customer.CustomerId)}")"
                                           @onclick:stopPropagation="true">
                                            @if (!string.IsNullOrWhiteSpace(customer.CustomerId))
                                            {
                                                <code>@customer.CustomerId</code>
                                            }
                                            @CustomerLabel(customer)
                                        </a>
                                    }
                                </td>
                                <td>@EuroFormatting.Format(invoice.TotalAmount)</td>
                            </tr>
                            @if (expanded)
                            {
                                @foreach (var line in invoice.Lines)
                                {
                                    <tr class="dashboard-table__line-row">
                                        <td>@line.Date.ToString("d")</td>
                                        <td colspan="2">@RevenueLineLabel(line)</td>
                                        <td>@EuroFormatting.Format(line.Amount)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
                @if (SalesGroups.Count > DashboardHomePreview.MaxRows)
                {
                    <p class="dashboard-preview-note">@DashboardHomePreview.TruncationNote(SalesGroups.Count, mostRecent: !_salesSort.IsActive)</p>
                }
            }
        </section>

        <section class="dashboard-section">
            <h2>Customers with sales orders (@DashboardHomePreview.TitleCount(CustomersPreview.Count, _overview.Customers.Count))</h2>
            @if (_overview.Customers.Count == 0)
            {
                <p class="dashboard-empty">No customers linked to sales orders in this period.</p>
            }
            else
            {
                <table class="dashboard-table" aria-label="Customers in period">
                    <thead>
                        <tr>
                            <SortableHeader Column="name" Label="Customer" Sort="_customersSort" />
                            <SortableHeader Column="city" Label="City" Sort="_customersSort" />
                            <SortableHeader Column="category" Label="Category" Sort="_customersSort" />
                            <SortableHeader Column="subcategory" Label="Subcategory" Sort="_customersSort" />
                            <SortableHeader Column="contact" Label="Contact" Sort="_customersSort" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in CustomersPreview)
                        {
                            <tr>
                                <td>@customer.Name</td>
                                <td>@customer.City</td>
                                <td>@customer.Category</td>
                                <td>@customer.Subcategory</td>
                                <td>@customer.ContactEmail</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_overview.Customers.Count > DashboardHomePreview.MaxRows)
                {
                    <p class="dashboard-preview-note">@DashboardHomePreview.TruncationNote(_overview.Customers.Count, mostRecent: false)</p>
                }
            }
        </section>

        @* One row per order id, same grouping as the customer page. Click a row to see its lines. *@
        <section class="dashboard-section">
            <h2>Open sales orders and period transactions (@DashboardHomePreview.TitleCount(TransactionsPreview.Count, TransactionGroups.Count))</h2>
            @if (_overview.Transactions.Count == 0)
            {
                <p class="dashboard-empty">No open sales orders or other transactions in this period.</p>
            }
            else
            {
                <table class="dashboard-table" aria-label="Open sales orders and period transactions">
                    <thead>
                        <tr>
                            <SortableHeader Column="date" Label="Date" Sort="_transactionsSort" />
                            <SortableHeader Column="order" Label="Order" Sort="_transactionsSort" />
                            <SortableHeader Column="type" Label="Type" Sort="_transactionsSort" />
                            <SortableHeader Column="party" Label="Customer / Supplier" Sort="_transactionsSort" />
                            <SortableHeader Column="qty" Label="Qty open" Sort="_transactionsSort" />
                            <SortableHeader Column="amount" Label="Amount" Sort="_transactionsSort" />
                            <StatusColumnHeader Kind="StatusLegendKind.OpenTransaction" Sort="_transactionsSort" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in TransactionsPreview)
                        {
                            var expanded = IsOrderExpanded(order.Key);
                            var first = order.Lines[0];
                            <tr class="dashboard-table__group-row"
                                @onclick="() => ToggleOrder(order.Key)"
                                tabindex="0"
                                aria-expanded="@expanded"
                                @onkeydown="(args) => HandleOrderKeyDown(args, order.Key)">
                                <td>@order.Date.ToString("d")</td>
                                <td>
                                    <span class="dashboard-table__toggle" aria-hidden="true">@(expanded ? "▼" : "▶")</span>
                                    <code>@order.OrderLabel</code>
                                </td>
                                <td>@first.Type</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(first.CustomerId))
                                    {
                                        <a class="dashboard-table__customer-link"
                                           href="@($"/customers/{Uri.EscapeDataString(first.CustomerId)}")"
                                           @onclick:stopPropagation="true">
                                            <code>@first.CustomerId</code>
                                            @PartyName(first.CustomerName, first.CustomerId)
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(first.SupplierId))
                                    {
                                        <a class="dashboard-table__customer-link"
                                           href="@($"/suppliers/{Uri.EscapeDataString(first.SupplierId)}")"
                                           @onclick:stopPropagation="true">
                                            <code>@first.SupplierId</code>
                                            @PartyName(first.SupplierName, first.SupplierId)
                                        </a>
                                    }
                                    else
                                    {
                                        @:—
                                    }
                                </td>
                                <td>@order.TotalQuantityOpen.ToString("N0")</td>
                                <td>@EuroFormatting.Format(order.TotalAmount)</td>
                                <td>
                                    @* Compact NetSuite letter; hover the letter for the full status name. *@
                                    <TransactionStatusMark Status="@order.Status" Type="@first.Type" />
                                </td>
                            </tr>
                            @if (expanded)
                            {
                                @foreach (var line in order.Lines)
                                {
                                    <tr class="dashboard-table__line-row">
                                        <td>@line.TransactionDate.ToString("d")</td>
                                        <td colspan="3">
                                            @if (string.IsNullOrWhiteSpace(line.ItemId))
                                            {
                                                @line.ItemName
                                            }
                                            else
                                            {
                                                <a class="dashboard-table__customer-link"
                                                   href="@($"/inventory/{Uri.EscapeDataString(line.ItemId)}")">
                                                    @line.ItemName
                                                </a>
                                            }
                                        </td>
                                        <td>@line.QuantityOpen.ToString("N0")</td>
                                        <td>@EuroFormatting.Format(line.Amount)</td>
                                        <td>
                                            <TransactionStatusMark Status="@line.Status" Type="@line.Type" />
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
                @if (TransactionGroups.Count > DashboardHomePreview.MaxRows)
                {
                    <p class="dashboard-preview-note">@DashboardHomePreview.TruncationNote(TransactionGroups.Count, mostRecent: !_transactionsSort.IsActive)</p>
                }
            }
        </section>

        @* One row per supplier. Click a row to see that supplier's bills, including the bill id. *@
        <section class="dashboard-section">
            <h2>Expenses in period (@DashboardHomePreview.TitleCount(ExpensesPreview.Count, ExpenseGroups.Count))</h2>
            @if (_overview.Expenses.Count == 0)
            {
                <p class="dashboard-empty">No expenses in this period.</p>
            }
            else
            {
                <table class="dashboard-table" aria-label="Expenses in period">
                    <thead>
                        <tr>
                            <SortableHeader Column="date" Label="Date" Sort="_expensesSort" />
                            <SortableHeader Column="supplier" Label="Supplier" Sort="_expensesSort" />
                            <SortableHeader Column="amount" Label="Amount" Sort="_expensesSort" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in ExpensesPreview)
                        {
                            var expanded = IsExpenseExpanded(supplier.Key);
                            <tr class="dashboard-table__group-row"
                                @onclick="() => ToggleExpense(supplier.Key)"
                                tabindex="0"
                                aria-expanded="@expanded"
                                @onkeydown="(args) => HandleExpenseKeyDown(args, supplier.Key)">
                                <td>@supplier.Date.ToString("d")</td>
                                <td>
                                    <span class="dashboard-table__toggle" aria-hidden="true">@(expanded ? "▼" : "▶")</span>
                                    @if (string.IsNullOrWhiteSpace(supplier.SupplierId))
                                    {
                                        @supplier.SupplierLabel
                                    }
                                    else
                                    {
                                        <a class="dashboard-table__customer-link"
                                           href="@($"/suppliers/{Uri.EscapeDataString(supplier.SupplierId)}")"
                                           @onclick:stopPropagation="true">
                                            <code>@supplier.SupplierId</code>
                                            @if (!string.IsNullOrWhiteSpace(supplier.SupplierLabel))
                                            {
                                                @supplier.SupplierLabel
                                            }
                                        </a>
                                    }
                                </td>
                                <td>@EuroFormatting.Format(supplier.TotalAmount)</td>
                            </tr>
                            @if (expanded)
                            {
                                @foreach (var line in supplier.Lines)
                                {
                                    <tr class="dashboard-table__line-row">
                                        <td>@line.Date.ToString("d")</td>
                                        <td>
                                            <code>@line.Id</code>
                                            @if (!string.IsNullOrWhiteSpace(line.Category))
                                            {
                                                <text> · @line.Category</text>
                                            }
                                        </td>
                                        <td>@EuroFormatting.Format(line.Amount)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
                @if (ExpenseGroups.Count > DashboardHomePreview.MaxRows)
                {
                    <p class="dashboard-preview-note">@DashboardHomePreview.TruncationNote(ExpenseGroups.Count, mostRecent: !_expensesSort.IsActive)</p>
                }
            }
            @* Home stays a preview. The expenses page lists every bill in the period. *@
            <p class="dashboard-section__more"><a href="/expenses">View all expenses →</a></p>
        </section>

        <section class="dashboard-section">
            <h2>Inventory with activity (@DashboardHomePreview.TitleCount(InventoryPreview.Count, _overview.InventoryWithActivity.Count))</h2>
            @if (_overview.InventoryWithActivity.Count == 0)
            {
                <p class="dashboard-empty">No inventory items linked to transactions in this period.</p>
            }
            else
            {
                <table class="dashboard-table" aria-label="Inventory with activity">
                    <thead>
                        <tr>
                            <SortableHeader Column="name" Label="Item" Sort="_inventorySort" />
                            <SortableHeader Column="onhand" Label="On hand" Sort="_inventorySort" />
                            <StatusColumnHeader Kind="StatusLegendKind.InventoryStock" Sort="_inventorySort" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in InventoryPreview)
                        {
                            <tr class="dashboard-table__link" @onclick="() => OpenItem(item.ItemId)" tabindex="0">
                                <td>@item.ItemName</td>
                                <td>@item.QuantityOnHand.ToString("N0")</td>
                                <td>@(item.IsLowStock ? "Low stock" : "OK")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_overview.InventoryWithActivity.Count > DashboardHomePreview.MaxRows)
                {
                    <p class="dashboard-preview-note">@DashboardHomePreview.TruncationNote(_overview.InventoryWithActivity.Count, mostRecent: false)</p>
                }
            }
        </section>
    }
</div>

@code {
    [CascadingParameter(Name = "PeriodFilter")]
    private IPeriodFilterService? CascadedPeriodFilter { get; set; }

    private IPeriodFilterService PeriodFilter => CascadedPeriodFilter ?? InjectedPeriodFilter;

    private readonly PeriodFilterSubscription _periodSubscription = new();
    private readonly PeriodFilterReload _periodReload = new();
    private PeriodOverviewDto? _overview;
    private IReadOnlyList<ChartBarItem> _revenueChartItems = [];
    private IReadOnlyList<ChartBarItem> _trendChartItems = [];
    private decimal _quarterGoalPercentage;
    private string _goalPeriodLabel = string.Empty;
    private IReadOnlyList<TopSellingItemDto> _popularItems = [];
    private string? _popularError;
    private bool _isLoading = true;
    private bool _isInitialLoad = true;
    private string? _error;
    private readonly HashSet<string> _expandedInvoices = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expandedOrders = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expandedExpenses = new(StringComparer.OrdinalIgnoreCase);
    private readonly ListSortState _salesSort = new();
    private readonly ListSortState _customersSort = new();
    private readonly ListSortState _transactionsSort = new();
    private readonly ListSortState _expensesSort = new();
    private readonly ListSortState _inventorySort = new();

    /// <summary>
    /// Change versus the previous window when the overview includes one. Otherwise the summary word.
    /// </summary>
    private string RevenueTrendText
    {
        get
        {
            var points = _overview?.Trend ?? [];
            if (points.Count < 2)
            {
                return _overview?.Summary.RevenueTrend ?? string.Empty;
            }

            var current = points[^1];
            var previous = points[^2];
            return $"{PeriodTrendWindows.DescribeChange(current.Revenue, previous.Revenue)} vs {TrendPeriodLabel(previous)}";
        }
    }

    /// <summary>One date when the window is a single day, otherwise the full range.</summary>
    private static string TrendPeriodLabel(PeriodTrendPointDto point)
    {
        var culture = CultureInfo.GetCultureInfo("nl-NL");
        const string pattern = "dd-MM-yyyy";
        return point.From == point.To
            ? point.From.ToString(pattern, culture)
            : $"{point.From.ToString(pattern, culture)} – {point.To.ToString(pattern, culture)}";
    }

    /// <summary>Invoices in the period, newest first unless a column sort is active.</summary>
    private IReadOnlyList<InvoiceRevenueGroup> SalesGroups
    {
        get
        {
            if (_overview is null)
            {
                return [];
            }

            var groups = InvoiceRevenueGroups.From(_overview.Revenue);
            return ListSort.Apply(groups, _salesSort, invoice => _salesSort.Column switch
            {
                "date" => invoice.Date,
                "invoice" => invoice.InvoiceLabel,
                "customer" => CustomerLabel(invoice.Lines[0]),
                "amount" => invoice.TotalAmount,
                _ => invoice.Date
            });
        }
    }

    /// <summary>Newest 20 invoices unless a column sort is active. KPIs still use every revenue line.</summary>
    private IReadOnlyList<InvoiceRevenueGroup> SalesPreview => DashboardHomePreview.MostRecent(SalesGroups);

    /// <summary>First 20 customers unless a column sort is active.</summary>
    private IReadOnlyList<CustomerDto> CustomersPreview =>
        _overview is null
            ? []
            : ListSort.ApplyThenPreview(_overview.Customers, _customersSort, customer => _customersSort.Column switch
            {
                "name" => customer.Name,
                "city" => customer.City,
                "category" => customer.Category,
                "subcategory" => customer.Subcategory,
                "contact" => customer.ContactEmail,
                _ => customer.Name
            });

    /// <summary>Orders in the period, grouped like the customer page.</summary>
    private IReadOnlyList<SalesOrderGroup> TransactionGroups
    {
        get
        {
            if (_overview is null)
            {
                return [];
            }

            var groups = SalesOrderGroups.From(_overview.Transactions);
            return ListSort.Apply(groups, _transactionsSort, order => _transactionsSort.Column switch
            {
                "date" => order.Date,
                "order" => order.OrderLabel,
                "type" => order.Lines[0].Type,
                "party" => PartyLabel(order.Lines[0]),
                "qty" => order.TotalQuantityOpen,
                "amount" => order.TotalAmount,
                "status" => order.Status,
                _ => order.Date
            });
        }
    }

    /// <summary>Newest 20 orders unless a column sort is active.</summary>
    private IReadOnlyList<SalesOrderGroup> TransactionsPreview => DashboardHomePreview.MostRecent(TransactionGroups);

    /// <summary>Expenses grouped by supplier, newest first unless a column sort is active.</summary>
    private IReadOnlyList<ExpenseSupplierGroup> ExpenseGroups
    {
        get
        {
            if (_overview is null)
            {
                return [];
            }

            var groups = ExpenseSupplierGroups.From(_overview.Expenses);
            return ListSort.Apply(groups, _expensesSort, group => _expensesSort.Column switch
            {
                "date" => group.Date,
                "supplier" => group.SupplierLabel,
                "amount" => group.TotalAmount,
                _ => group.Date
            });
        }
    }

    /// <summary>Newest 20 suppliers unless a column sort is active. Period KPIs still use every bill.</summary>
    private IReadOnlyList<ExpenseSupplierGroup> ExpensesPreview => DashboardHomePreview.MostRecent(ExpenseGroups);

    /// <summary>First 20 inventory rows with activity unless a column sort is active.</summary>
    private IReadOnlyList<InventoryItemDto> InventoryPreview =>
        _overview is null
            ? []
            : ListSort.ApplyThenPreview(_overview.InventoryWithActivity, _inventorySort, item => _inventorySort.Column switch
            {
                "name" => item.ItemName,
                "onhand" => item.QuantityOnHand,
                "status" => item.IsLowStock,
                _ => item.ItemName
            });

    protected override void OnParametersSet()
    {
        _periodSubscription.Bind(CascadedPeriodFilter, InjectedPeriodFilter, OnPeriodChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadOverviewAsync(_periodReload.BeginReload(), showLoadingSpinner: true);
    }

    private void OnPeriodChanged()
    {
        _ = InvokeAsync(ReloadOverviewAsync);
    }

    private async Task ReloadOverviewAsync()
    {
        var generation = _periodReload.BeginReload();
        await LoadOverviewAsync(generation, showLoadingSpinner: false);

        if (!_periodReload.IsCurrent(generation))
        {
            return;
        }

        StateHasChanged();
    }

    private async Task LoadOverviewAsync(int generation, bool showLoadingSpinner)
    {
        var from = PeriodFilter.From;
        var to = PeriodFilter.To;

        if (showLoadingSpinner)
        {
            _isLoading = true;
            _error = null;
        }

        try
        {
            var overview = await ApiClient.GetPeriodOverviewAsync(from, to);

            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            if (overview is null)
            {
                _error = "No overview data returned from the API.";
                return;
            }

            _overview = overview;
            _revenueChartItems = RevenueChartItems.FromDailyTotals(_overview.Revenue);
            _trendChartItems = overview.Trend
                .Select(point => new ChartBarItem
                {
                    Label = TrendPeriodLabel(point),
                    Value = point.Revenue
                })
                .ToList();

            await LoadQuarterGoalAsync();
            await LoadPopularItemsAsync();
        }
        catch (Exception ex)
        {
            if (!_periodReload.IsCurrent(generation))
            {
                return;
            }

            _error = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            if (showLoadingSpinner)
            {
                _isLoading = false;
                _isInitialLoad = false;
            }
        }
    }

    private async Task LoadQuarterGoalAsync()
    {
        var periodEnd = PeriodFilter.To;
        var quarter = PeriodHelper.GetQuarter(periodEnd);
        _goalPeriodLabel = $"{quarter} {periodEnd.Year}";

        var goals = await ApiClient.GetGoalsAsync(periodEnd.Year, quarter);
        var companyGoal = goals.FirstOrDefault(goal => string.IsNullOrWhiteSpace(goal.ItemId));

        _quarterGoalPercentage = companyGoal?.Percentage ?? _overview?.Summary.GoalPercentage ?? 0m;
    }

    private async Task LoadPopularItemsAsync()
    {
        try
        {
            _popularItems = await ApiClient.GetPopularItemsAsync(PeriodFilter.From, PeriodFilter.To);
            _popularError = null;
        }
        catch (Exception ex)
        {
            _popularItems = [];
            _popularError = $"Popular articles could not be loaded: {ex.Message}";
        }
    }

    private void OpenItem(string itemId) => Navigation.NavigateTo($"/inventory/{Uri.EscapeDataString(itemId)}");

    // Name only. The id is rendered beside it so a blank name does not repeat the id.
    private static string CustomerLabel(RevenueDto row) =>
        PartyName(row.CustomerName, row.CustomerId);

    private static string PartyLabel(OpenTransactionDto line) =>
        !string.IsNullOrWhiteSpace(line.CustomerId)
            ? PartyName(line.CustomerName, line.CustomerId)
            : PartyName(line.SupplierName, line.SupplierId);

    private static string PartyName(string? name, string? id) =>
        !string.IsNullOrWhiteSpace(name)
        && !string.Equals(name, id, StringComparison.OrdinalIgnoreCase)
            ? name
            : string.Empty;

    // Expanded invoice lines show the article and artikelgroep, same as the customer page.
    private static string RevenueLineLabel(RevenueDto row)
    {
        var item = !string.IsNullOrWhiteSpace(row.ItemName) ? row.ItemName : row.ItemId;
        var group = ProductGroupLabel.For(row);
        if (string.IsNullOrWhiteSpace(group))
        {
            return item;
        }

        if (string.IsNullOrWhiteSpace(item))
        {
            return group;
        }

        return $"{item} · {group}";
    }

    private bool IsInvoiceExpanded(string key) => _expandedInvoices.Contains(key);

    private void ToggleInvoice(string key)
    {
        if (!_expandedInvoices.Add(key))
        {
            _expandedInvoices.Remove(key);
        }
    }

    private void HandleInvoiceKeyDown(KeyboardEventArgs args, string key)
    {
        if (args.Key is "Enter" or " ")
        {
            ToggleInvoice(key);
        }
    }

